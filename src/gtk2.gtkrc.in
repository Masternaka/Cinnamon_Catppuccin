# ============================================================================
# Catppuccin @flavor@ for GTK 2
# Palette: https://catppuccin.com/palette/
# Generated from src/gtk2.gtkrc.in by scripts/build.py
# Do not edit this file directly: edit the template and rebuild.
#
# GTK 2 is legacy, but Nemo, Synaptic and a few Mint tools can still load it.
# Only colors and basic padding are set so the theme stays compatible with the
# stock GTK 2 engine.
# ============================================================================

gtk-color-scheme = "fg_color:@text@\nbg_color:@base@\nbase_color:@base@\ntext_color:@text@\nselected_bg_color:@accent@\nselected_fg_color:@on_accent@\ntooltip_bg_color:@mantle@\ntooltip_fg_color:@text@\nlink_color:@link@"

style "catppuccin-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]        = "@text@"
  fg[PRELIGHT]      = "@text@"
  fg[ACTIVE]        = "@text@"
  fg[SELECTED]      = "@on_accent@"
  fg[INSENSITIVE]   = "@overlay1@"

  bg[NORMAL]        = "@base@"
  bg[PRELIGHT]      = "@surface0@"
  bg[ACTIVE]        = "@surface1@"
  bg[SELECTED]      = "@accent@"
  bg[INSENSITIVE]   = "@mantle@"

  base[NORMAL]      = "@base@"
  base[PRELIGHT]    = "@surface0@"
  base[ACTIVE]      = "@surface1@"
  base[SELECTED]    = "@accent@"
  base[INSENSITIVE] = "@mantle@"

  text[NORMAL]      = "@text@"
  text[PRELIGHT]    = "@text@"
  text[ACTIVE]      = "@text@"
  text[SELECTED]    = "@on_accent@"
  text[INSENSITIVE] = "@overlay1@"
}

class "GtkWidget" style "catppuccin-default"

style "catppuccin-button" {
  xthickness = 6
  ythickness = 4

  fg[NORMAL]        = "@text@"
  fg[PRELIGHT]      = "@text@"
  fg[ACTIVE]        = "@text@"
  fg[INSENSITIVE]   = "@overlay1@"

  bg[NORMAL]        = "@surface0@"
  bg[PRELIGHT]      = "@surface1@"
  bg[ACTIVE]        = "@surface2@"
  bg[INSENSITIVE]   = "@mantle@"

  text[NORMAL]      = "@text@"
  text[PRELIGHT]    = "@text@"
  text[ACTIVE]      = "@text@"
  text[INSENSITIVE] = "@overlay1@"
}

widget_class "*GtkButton*" style "catppuccin-button"

style "catppuccin-entry" {
  xthickness = 4
  ythickness = 4

  fg[NORMAL]        = "@text@"
  fg[PRELIGHT]      = "@text@"
  fg[ACTIVE]        = "@text@"
  fg[SELECTED]      = "@on_accent@"
  fg[INSENSITIVE]   = "@overlay1@"

  bg[NORMAL]        = "@surface0@"
  bg[PRELIGHT]      = "@surface0@"
  bg[ACTIVE]        = "@surface0@"
  bg[SELECTED]      = "@accent@"
  bg[INSENSITIVE]   = "@mantle@"

  base[NORMAL]      = "@surface0@"
  base[PRELIGHT]    = "@surface0@"
  base[ACTIVE]      = "@surface0@"
  base[SELECTED]    = "@accent@"
  base[INSENSITIVE] = "@mantle@"

  text[NORMAL]      = "@text@"
  text[PRELIGHT]    = "@text@"
  text[ACTIVE]      = "@text@"
  text[SELECTED]    = "@on_accent@"
  text[INSENSITIVE] = "@overlay1@"
}

widget_class "*GtkEntry*" style "catppuccin-entry"

style "catppuccin-menu" {
  xthickness = 4
  ythickness = 3

  fg[NORMAL]        = "@text@"
  fg[PRELIGHT]      = "@text@"
  fg[ACTIVE]        = "@text@"
  fg[SELECTED]      = "@on_accent@"
  fg[INSENSITIVE]   = "@overlay1@"

  bg[NORMAL]        = "@mantle@"
  bg[PRELIGHT]      = "@surface0@"
  bg[ACTIVE]        = "@surface1@"
  bg[SELECTED]      = "@accent@"
  bg[INSENSITIVE]   = "@mantle@"
}

widget_class "*Menu*" style "catppuccin-menu"

style "catppuccin-tooltip" {
  fg[NORMAL]        = "@text@"
  fg[PRELIGHT]      = "@text@"

  bg[NORMAL]        = "@mantle@"
  bg[PRELIGHT]      = "@mantle@"
}

widget "gtk-tooltip*" style "catppuccin-tooltip"
