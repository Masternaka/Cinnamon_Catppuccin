/* ============================================================================
   Catppuccin @flavor@ for Cinnamon
   Palette: https://catppuccin.com/palette/
   Generated from src/cinnamon.css.in by scripts/build.py
   Do not edit this file directly: edit the template and rebuild.
   ========================================================================== */

/* ---------------------------------------------------------------------------
   Global
   ------------------------------------------------------------------------- */

stage {
  color: @text@;
}

.flashspot {
  background-color: @text@;
}

.caps-lock-warning-label {
  text-align: center;
  padding-bottom: 8px;
  font-weight: 700;
  font-size: 9pt;
  color: @text_warning@;
}

.cinnamon-link {
  color: @link@;
}

.cinnamon-link:hover {
  color: @link_hover@;
}

.lightbox {
  background-color: @backdrop@;
}

/* Looking Glass */

#LookingGlassDialog {
  color: @text@;
  background-color: @menu_bg@;
  border: 1px solid @menu_border@;
  border-radius: 8px;
  padding: 16px;
  spacing: 4px;
  box-shadow: 0 4px 12px 2px @shadow@;
}

/* Magnifier */

.magnifier-zoom-region {
  border: 2px solid @red@;
}

.magnifier-zoom-region.full-screen {
  border-width: 0;
}

/* Pie timer */

.pie-timer {
  width: 30px;
  height: 30px;
  -pie-border-width: 1px;
  -pie-border-color: @surface2@;
  -pie-background-color: @surface0@;
}

/* Placeholder (empty app grid, etc.) */

.placeholder {
  spacing: 8px;
  padding: 12px;
}

.placeholder .placeholder-icon {
  color: @overlay1@;
}

.placeholder .placeholder-label {
  font-weight: 700;
  font-size: 15pt;
  text-align: center;
  color: @insensitive@;
  padding-top: 8px;
}

.placeholder .placeholder-description {
  color: @insensitive@;
  text-align: center;
}

/* Ripples */

.ripple-pointer-location {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  background-color: @accent_a50@;
  box-shadow: 0 0 2px 2px @accent_a30@;
}

.ripple-box {
  width: 104px;
  height: 104px;
  background-image: url("corner-ripple.png");
}

.ripple-box:rtl {
  background-image: url("corner-ripple.png");
}

/* Scrollbars */

StScrollView.vfade {
  -st-vfade-offset: 68px;
}

StScrollBar {
  min-height: 8px;
  min-width: 8px;
}

StScrollBar StBin#trough {
  background-color: @surface0_a60@;
  border-radius: 99px;
}

StScrollBar StButton#vhandle,
StScrollBar StButton#hhandle {
  background-color: @overlay0@;
  border-radius: 99px;
}

StScrollBar StButton#vhandle:hover,
StScrollBar StButton#hhandle:hover {
  background-color: @overlay1@;
}

StScrollBar StButton#vhandle:active,
StScrollBar StButton#hhandle:active {
  background-color: @overlay2@;
}

/* Separators */

.separator {
  -gradient-height: 1px;
  -gradient-start: @surface1@;
  -gradient-end: @surface1@;
  -margin-horizontal: 0;
  height: 1px;
}

/* Sliders */

.slider,
.popup-slider-menu-item {
  height: 1em;
  min-width: 15em;
  -slider-height: 0.3em;
  -slider-background-color: @surface1@;
  -slider-active-background-color: @accent@;
  -slider-border-color: transparent;
  -slider-active-border-color: transparent;
  -slider-border-width: 1px;
  -slider-handle-radius: 0.5em;
}

/* Tile previews */

.tile-preview {
  background-color: @accent_a20@;
  border: 1px solid @accent_a60@;
}

/* Tooltips */

#Tooltip {
  color: @text@;
  background-color: @tooltip_bg@;
  border: 1px solid @surface1@;
  border-radius: 8px;
  padding: 8px 10px;
  margin: 4px;
  text-align: center;
  box-shadow: 0 2px 6px 0 @shadow_soft@;
}

/* User avatar */

.user-icon {
  background-size: contain;
  border-radius: 99px;
  color: @text@;
  border-color: transparent;
}

.user-icon StIcon {
  padding: 12px;
  border: 1px solid transparent;
  border-radius: 99px;
  background-color: @surface0@;
}

.user-icon.user-avatar {
  border: transparent;
  border-radius: 99px;
}

.user-icon StIcon.highlighted {
  border: 1px solid @accent@;
  border-radius: 99px;
}

.user-widget-label {
  color: @text@;
}

.user-widget.horizontal {
  spacing: 6px;
}

.user-widget.vertical {
  spacing: 6px;
}

.user-widget.vertical .user-widget-label {
  font-weight: 700;
  font-size: 0.9em;
  color: @text@;
  text-align: center;
}

/* ---------------------------------------------------------------------------
   Entries
   ------------------------------------------------------------------------- */

StEntry {
  min-height: 22px;
  border-radius: 8px;
  padding: 6px 9px;
  border: 1px solid @entry_border@;
  background-color: @entry_bg@;
  color: @text@;
  caret-color: @text@;
  caret-size: 1px;
  selected-color: @on_accent@;
  selection-background-color: @accent@;
  -st-progress-color: @accent@;
}

StEntry:focus {
  border-color: @accent@;
}

StEntry:insensitive {
  color: @insensitive@;
  background-color: @mantle@;
  border-color: @surface1@;
}

StEntry StLabel.hint-text {
  color: @text_a30@;
}

StEntry .capslock-warning {
  icon-size: 1.1em;
  color: @text_warning@;
}

StEntry StIcon.peek-password {
  icon-size: 16px;
  color: @subtext0@;
}

#appmenu-search-entry,
#menu-search-entry,
.run-dialog-entry,
.prompt-dialog-password-entry,
.expo-workspaces-name-entry {
  min-height: 22px;
  border-radius: 8px;
  padding: 6px 9px;
  border: 1px solid @entry_border@;
  background-color: @entry_bg@;
  color: @text@;
  caret-color: @text@;
  caret-size: 1px;
  selected-color: @on_accent@;
  selection-background-color: @accent@;
  -st-progress-color: @accent@;
}

#appmenu-search-entry:focus,
#menu-search-entry:focus,
.run-dialog-entry:focus,
.prompt-dialog-password-entry:focus,
.expo-workspaces-name-entry:focus {
  border-color: @accent@;
}

.run-dialog-entry {
  width: 20em;
  height: 1.2em;
}

.prompt-dialog-password-entry {
  width: 20em;
}

/* ---------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */

.button,
.dialog-button,
.notification-button,
.notification-icon-button {
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
  border-radius: 8px;
  padding: 6px 18px;
  font-weight: bold;
}

.button:hover,
.dialog-button:hover,
.notification-button:hover,
.notification-icon-button:hover {
  background-color: @surface1@;
}

.button:active,
.button:checked,
.dialog-button:active,
.dialog-button:checked,
.notification-button:active,
.notification-icon-button:active {
  background-color: @surface2@;
}

.button:focus,
.dialog-button:focus,
.notification-button:focus,
.notification-icon-button:focus {
  box-shadow: inset 0 0 1px 2px @accent@;
}

.button:insensitive,
.dialog-button:insensitive,
.notification-button:insensitive,
.notification-icon-button:insensitive {
  color: @insensitive@;
  background-color: @mantle@;
  border-color: @surface0@;
}

.button {
  min-height: 22px;
}

.button.flat {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

.button.flat:hover {
  background-color: @surface0@;
}

.button.flat:active,
.button.flat:checked,
.button.flat:selected {
  background-color: @surface1@;
}

.button.flat:insensitive {
  background-color: transparent;
  color: @insensitive@;
}

.icon-button {
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
  border-radius: 99px;
  padding: 6px;
  min-height: 16px;
}

.icon-button:hover {
  background-color: @surface1@;
}

.icon-button:active,
.icon-button:checked {
  background-color: @surface2@;
}

.icon-button:focus {
  box-shadow: inset 0 0 1px 2px @accent@;
}

.icon-button:insensitive {
  color: @insensitive@;
  background-color: @mantle@;
  border-color: @surface0@;
}

.icon-button StIcon {
  icon-size: 16px;
}

.icon-button.flat {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

.icon-button.flat:hover {
  background-color: @surface0@;
}

.icon-button.flat:active,
.icon-button.flat:checked,
.icon-button.flat:selected {
  background-color: @surface1@;
}

.icon-button.flat:insensitive {
  background-color: transparent;
  color: @insensitive@;
}

/* Dialog buttons */

.dialog-button {
  padding: 12px;
  border-radius: 12px;
}

.dialog-button:default {
  color: @on_accent@;
  background-color: @accent@;
  border-color: @accent@;
}

.dialog-button:default:hover {
  background-color: @accent_hover@;
  border-color: @accent_hover@;
}

.dialog-button:default:active,
.dialog-button:default:checked {
  background-color: @accent_active@;
  border-color: @accent_active@;
}

.dialog-button:default:insensitive {
  color: @insensitive@;
  background-color: @mantle@;
  border-color: @surface0@;
}

.dialog-button:destructive-action {
  color: @on_accent@;
  background-color: @red@;
  border-color: @red@;
}

.dialog-button:destructive-action:hover {
  background-color: @maroon@;
  border-color: @maroon@;
}

.dialog-button:destructive-action:active,
.dialog-button:destructive-action:checked {
  background-color: @red@;
  border-color: @red@;
}

.dialog-button:destructive-action:insensitive {
  color: @insensitive@;
  background-color: @mantle@;
  border-color: @surface0@;
}

/* ---------------------------------------------------------------------------
   Panel
   ------------------------------------------------------------------------- */

.panel-top,
.panel-bottom,
.panel-left,
.panel-right {
  font-weight: bold;
  color: @text@;
  background-color: @panel@;
}

.panel-top {
  box-shadow: inset 0 -1px @panel_border@;
}

.panel-bottom {
  box-shadow: inset 0 1px @panel_border@;
}

.panel-left {
  box-shadow: inset -1px 0 @panel_border@;
}

.panel-right {
  box-shadow: inset 1px 0 @panel_border@;
}

.panelLeft {
  spacing: 4px;
}

.panelLeft:dnd {
  background-color: @blue_a25@;
}

.panelLeft:ltr {
  padding-right: 4px;
}

.panelLeft:rtl {
  padding-left: 4px;
}

.panelLeft.vertical {
  padding: 0;
}

.panelLeft.vertical:ltr {
  padding-right: 0;
}

.panelLeft.vertical:rtl {
  padding-left: 0;
}

.panelRight:dnd {
  background-color: @accent_a25@;
}

.panelRight:ltr {
  padding-left: 4px;
  spacing: 0;
}

.panelRight:rtl {
  padding-right: 4px;
  spacing: 0;
}

.panelRight.vertical {
  padding: 0;
}

.panelRight.vertical:ltr {
  padding-left: 0;
  spacing: 0;
}

.panelRight.vertical:rtl {
  padding-right: 0;
  spacing: 0;
}

.panelCenter {
  spacing: 4px;
}

.panelCenter:dnd {
  background-color: @green_a25@;
}

.panelCenter.vertical {
  padding-left: 0;
  padding-right: 0;
}

.panel-dummy {
  background-color: @red_a50@;
}

.panel-dummy:entered {
  background-color: @red_a60@;
}

.panel-status-button {
  border-width: 0;
  -natural-hpadding: 3px;
  -minimum-hpadding: 3px;
  font-weight: bold;
  color: @text@;
}

.panel-corner {
  background-color: @panel@;
}

.panel-corner:overview {
  background-color: @panel@;
}

.panel-corner:active,
.panel-corner:focus {
  background-color: @panel@;
}

#panel:highlight {
  background-color: @accent_a50@;
}

/* ---------------------------------------------------------------------------
   Applets
   ------------------------------------------------------------------------- */

.applet-box {
  padding: 0 6px;
  spacing: 6px;
  text-align: center;
  border-radius: 6px;
  color: @text@;
}

.applet-box.vertical {
  padding: 6px 0;
}

.applet-box:hover {
  background-color: @surface0@;
}

.applet-box:checked,
.applet-box:active {
  background-color: @surface1@;
}

.applet-box:highlight {
  background-color: @red_a50@;
}

.applet-label {
  font-weight: bold;
  color: @text@;
}

.applet-icon {
  icon-size: 1.1em;
  color: @text@;
}

.applet-separator {
  padding: 1px 4px;
}

.applet-separator.vertical {
  padding: 4px 1px;
}

.applet-separator-line {
  width: 1px;
  background-color: @text_a20@;
}

.applet-separator-line-vertical {
  height: 1px;
  background-color: @text_a20@;
}

/* Corner bar */

.applet-cornerbar {
  width: 8px;
  background-color: @surface0@;
  border: 1px solid @surface1@;
}

.applet-cornerbar.vertical {
  height: 8px;
}

.applet-cornerbar-box {
  background: none;
}

.applet-cornerbar-box:hover > .applet-cornerbar {
  background-color: @surface1@;
}

/* Notification applet */

.notification-applet-padding {
  padding: 4px 0 4px 4px;
}

/* Panel launchers */

.panel-launchers {
  spacing: 2px;
}

.panel-launchers .launcher {
  padding: 0 2px;
  border-radius: 6px;
}

.panel-launchers .launcher:hover {
  background-color: @surface0@;
}

.panel-launchers.vertical {
  padding: 2px 0;
}

.panel-launchers.vertical .launcher {
  padding: 2px 0;
}

/* Power applet */

.device-box .device-icon {
  icon-size: 1.4em;
  color: @text@;
}

.device-box .device-labels {
  margin-left: 8px;
  spacing: 4px;
}

.device-box .device-labels .primary-label {
  font-weight: 700;
  color: @text@;
}

.device-box .device-labels .status-label {
  color: @subtext0@;
}

/* Sound applet */

.sound-player > StBoxLayout:first-child {
  spacing: 4px;
  padding: 0 6px;
}

.sound-player StButton {
  width: 18px;
  height: 18px;
  padding: 6px;
  border-radius: 8px;
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
}

.sound-player StButton:hover {
  background-color: @surface1@;
}

.sound-player StButton:active {
  background-color: @surface2@;
}

.sound-player StButton:focus {
  box-shadow: inset 0 0 1px 2px @accent@;
}

.sound-player StButton StIcon {
  icon-size: 1em;
}

.sound-player StButton:small {
  width: 16px;
  height: 16px;
  background-color: transparent;
  border-color: transparent;
}

.sound-player StButton:small:hover {
  background-color: @surface0@;
}

.sound-player StButton:small StIcon {
  icon-size: 1.2em;
}

.sound-player-generic-coverart {
  background-color: @surface0@;
}

.sound-player-overlay {
  width: 290px;
  padding: 12px;
  spacing: 4px;
  color: @text@;
  background-color: @mantle_a95@;
}

.sound-player-overlay StBoxLayout {
  padding-top: 2px;
}

.sound-player-overlay > StBoxLayout {
  spacing: 6px;
}

.sound-player-overlay StBin > StBoxLayout {
  spacing: 6px;
}

.sound-player .slider {
  height: 6px;
  -slider-height: 6px;
  -slider-background-color: @surface1@;
  -slider-active-background-color: @accent@;
  -slider-border-color: transparent;
  -slider-active-border-color: transparent;
  -slider-border-width: 0;
  -slider-handle-radius: 0;
}

/* Spacer */

.spacer-box {
  border: 1px solid transparent;
}

.spacer-box:highlight {
  background-color: @red@;
}

.spacer-box.edit-mode {
  border: 1px symbolic;
}

/* Systray */

.systray {
  padding: 0;
  spacing: 4px;
  color: @text@;
}

/* Workspace switcher applet */

.panel-top .workspace-switcher,
.panel-bottom .workspace-switcher {
  padding: 0 4px;
}

.workspace-button {
  border: 1px solid @surface1@;
  width: 2em;
  color: @insensitive@;
  background-color: @text_a05@;
}

.workspace-button.vertical {
  height: 2em;
}

.workspace-button:outlined {
  background-color: @surface0@;
  color: @text@;
}

.workspace-button:outlined:hover {
  background-color: @surface1@;
}

.workspace-button:hover {
  background-color: @surface0@;
}

.workspace-button:shaded {
  background-color: @mantle@;
}

.workspace-graph {
  padding: 4px;
  spacing: 4px;
}

.workspace-graph .workspace {
  border: 1px solid @surface1@;
  background-color: @mantle@;
}

.workspace-graph .workspace:active {
  border-color: @accent@;
}

.workspace-graph .workspace .windows {
  -active-window-background: @accent_a60@;
  -active-window-border: @accent@;
  -inactive-window-background: @text_a15@;
  -inactive-window-border: @text_a25@;
}

.workspace-graph .workspace:active .windows {
  -active-window-background: @accent_a80@;
  -active-window-border: @accent@;
  -inactive-window-background: @text_a25@;
  -inactive-window-border: @text_a40@;
}

/* Status icons */

.system-status-icon {
  icon-size: 1.1em;
}

.system-status-icon.warning {
  color: @text_warning@;
}

.system-status-icon.error {
  color: @text_error@;
}

/* ---------------------------------------------------------------------------
   Menus (classic and popup menus)
   ------------------------------------------------------------------------- */

.menu {
  min-width: 15em;
  color: @text@;
  padding: 6px;
}

.popup-menu-content {
  padding: 6px;
  color: @text@;
  background-color: @menu_bg@;
  border-radius: 12px;
  border: 1px solid @menu_border@;
  box-shadow: 0 2px 8px 0 @shadow@;
}

.popup-menu-item {
  font-weight: normal;
  spacing: 8px;
  transition-duration: 100ms;
  padding: 8px 12px;
  margin: 0 4px;
  border-radius: 8px;
  color: @text@;
}

.popup-menu-item:hover,
.popup-menu-item:active,
.popup-menu-item:selected,
.popup-menu-item:focus {
  background-color: @surface0@;
}

.popup-menu-item:insensitive {
  color: @insensitive@;
  background: none;
}

.popup-menu-item .check-box StBoxLayout,
.popup-menu-item .radiobutton StBoxLayout {
  spacing: 0;
}

/* Indicator dot set by PopupBaseMenuItem.setShowDot() (active sound player or
   output device). Without an explicit size the St.DrawingArea stays invisible. */

.popup-menu-item-dot {
  width: 6px;
  height: 6px;
  margin: 0 6px;
  color: @accent@;
}

.popup-menu-arrow,
.popup-menu-icon {
  icon-size: 1.1em;
}

.appmenu-sidebar-button StIcon,
.appmenu-application-button StIcon,
.appmenu-category-button StIcon,
.appmenu-system-button StIcon,
.menu-application-button StIcon,
.menu-category-button StIcon,
.menu-favorites-button StIcon,
.window-list-item-box StIcon,
.grouped-window-list-item-box StIcon {
  color: inherit;
}

.popup-inhibitor-menu-item .popup-menu-icon {
  icon-size: 1.5em;
}

.popup-sub-menu {
  background-color: @sidebar_bg@;
  border: 1px solid @surface0@;
  border-radius: 9px;
  margin: 0 4px 6px 4px;
  padding: 4px;
}

.popup-sub-menu .popup-menu-item {
  background-color: transparent;
  margin: 0;
  padding: 8px 12px;
  border-radius: 6px;
}

.popup-sub-menu .popup-menu-item:hover,
.popup-sub-menu .popup-menu-item:active {
  background-color: @surface0@;
}

.popup-sub-menu StScrollBar {
  padding: 4px;
}

.popup-sub-menu StScrollBar StBin#trough,
.popup-sub-menu StScrollBar StBin#vhandle {
  border-width: 0;
}

.popup-submenu-menu-item:open {
  background-color: @surface0@;
}

.popup-separator-menu-item {
  -gradient-height: 1px;
  -gradient-start: @surface1@;
  -gradient-end: @surface1@;
  -margin-horizontal: 0;
  height: 1px;
}

.popup-combo-menu {
  padding: 6px;
  color: @text@;
  background-color: @menu_bg@;
  border-radius: 12px;
  border: 1px solid @menu_border@;
  box-shadow: 0 2px 6px 0 @shadow_soft@;
}

.popup-combobox-item {
  spacing: 8px;
  padding: 8px 12px;
  margin: 0 4px;
  border-radius: 8px;
  color: @text@;
}

.popup-combobox-item:hover,
.popup-combobox-item:active {
  background-color: @surface0@;
}

.popup-alternating-menu-item:alternate {
  font-weight: normal;
}

.popup-device-menu-item {
  spacing: 0.5em;
  font-weight: 700;
  font-size: 11pt;
  color: @text@;
}

.popup-device-menu-item:insensitive {
  color: @text@;
}

.popup-device-menu-item .popup-inactive-menu-item {
  font-weight: normal;
  color: @text@;
}

.popup-printer-menu-item {
  spacing-columns: 8px;
}

.popup-subtitle-menu-item {
  font-weight: normal;
}

.nm-menu-item-icons {
  spacing: 0.5em;
}

.wireless-active:insensitive {
  color: @text_error@;
}

/* ---------------------------------------------------------------------------
   Application menu (Cinnamon 6.6+)
   ------------------------------------------------------------------------- */

.appmenu-background .popup-menu-content {
  padding: 0;
  background-color: @menu_bg@;
}

.appmenu-main-box {
  spacing: 10px;
}

.appmenu-right-box {
  spacing: 5px;
  padding: 10px;
}

.appmenu-categories-applications-box {
  spacing: 15px;
}

.appmenu-categories-applications-box:top {
  padding-top: 5px;
}

.appmenu-applications-box {
  padding-right: 5px;
}

.appmenu-search-box {
  spacing: 10px;
}

.appmenu-sidebar {
  padding: 10px 0;
  color: @text@;
  background-color: @sidebar_bg@;
  border-radius: 12px 0 0 12px;
  border-right: 1px solid @surface0@;
}

.appmenu-sidebar-user-box {
  padding: 0 10px;
}

.appmenu-sidebar .appmenu-system-button {
  background-color: @surface0@;
  border-color: @surface1@;
}

.appmenu-sidebar .appmenu-system-button-lock:hover,
.appmenu-sidebar .appmenu-system-button-logout:hover {
  background-color: @surface1@;
}

.appmenu-sidebar .appmenu-system-button-shutdown {
  color: @on_accent@;
  background-color: @red@;
  border-color: @red@;
}

.appmenu-sidebar .appmenu-system-button-shutdown:hover {
  background-color: @maroon@;
  border-color: @maroon@;
}

.appmenu-system-box {
  spacing: 10px;
}

.appmenu-sidebar-button {
  padding: 3px 6px;
  margin: 0 10px;
  spacing: 4px;
  border-radius: 8px;
  color: @text@;
}

.appmenu-sidebar-button:hover {
  background-color: @surface0@;
}

.appmenu-sidebar-button:active {
  background-color: @surface1@;
}

.appmenu-system-button {
  padding: 8px;
  border: 1px solid @surface1@;
  border-radius: 99px;
  background-color: @surface0@;
}

.appmenu-system-button-lock:hover,
.appmenu-system-button-logout:hover {
  background-color: @surface1@;
}

.appmenu-system-button-shutdown {
  color: @on_accent@;
  background-color: @red@;
  border-color: @red@;
}

.appmenu-system-button-shutdown:hover {
  background-color: @maroon@;
  border-color: @maroon@;
}

.appmenu-application-button {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @text@;
}

.appmenu-application-button-label {
  padding: 0;
}

.appmenu-application-button-description {
  font-weight: 400;
  font-size: 9pt;
  color: @subtext0@;
}

.appmenu-application-button:highlighted {
  font-weight: bold;
}

.appmenu-application-button-selected {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  background-color: @surface0@;
  color: @text@;
}

.appmenu-application-button-selected:highlighted {
  font-weight: bold;
}

.appmenu-category-button {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @subtext0@;
}

.appmenu-category-button-label {
  padding: 0;
}

.appmenu-category-button:hover {
  background-color: @surface0@;
  color: @text@;
}

.appmenu-category-button-selected {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  background-color: @surface0@;
  color: @text@;
}

.appmenu-category-button-greyed {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @insensitive@;
  font-style: italic;
}

.appmenu-category-button-greyed StIcon {
  opacity: 0.5;
}

.appmenu-search-entry-icon {
  icon-size: 1.1em;
  color: @subtext0@;
}

/* ---------------------------------------------------------------------------
   Application menu (classic)
   ------------------------------------------------------------------------- */

.menu-favorites-box {
  padding: 9px;
  background-color: @sidebar_bg@;
  border: 1px solid @surface0@;
  border-radius: 8px;
}

.menu-favorites-button {
  padding: 9px;
  border-radius: 8px;
}

.menu-favorites-button:hover {
  background-color: @surface0@;
}

.menu-categories-box {
  padding: 9px 24px;
}

.menu-applications-box {
  padding: 9px;
}

.menu-applications-inner-box:ltr {
  padding-left: 24px;
}

.menu-applications-inner-box:rtl {
  padding-right: 24px;
}

.menu-application-button {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @text@;
}

.menu-application-button-label {
  padding: 0;
}

.menu-application-button:highlighted {
  font-weight: bold;
}

.menu-application-button-selected {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  background-color: @surface0@;
  color: @text@;
}

.menu-application-button-selected:highlighted {
  font-weight: bold;
}

.menu-category-button {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @subtext0@;
}

.menu-category-button-label {
  padding: 0;
}

.menu-category-button:hover {
  background-color: @surface0@;
  color: @text@;
}

.menu-category-button-selected {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  background-color: @surface0@;
  color: @text@;
}

.menu-category-button-greyed {
  padding: 6px;
  spacing: 4px;
  border-radius: 8px;
  color: @insensitive@;
  font-style: italic;
}

.menu-category-button-greyed StIcon {
  opacity: 0.5;
}

.menu-selected-app-box {
  padding-right: 24px;
  padding-left: 24px;
  text-align: right;
}

.menu-selected-app-title {
  font-size: 11pt;
  font-weight: 700;
  color: @text@;
}

.menu-selected-app-description {
  color: @subtext0@;
}

.menu-search-box {
  padding: 0 0 6px 9px;
}

.menu-search-entry-icon {
  icon-size: 1.1em;
  color: @subtext0@;
}

/* ---------------------------------------------------------------------------
   Window list
   ------------------------------------------------------------------------- */

.grouped-window-list-box {
  spacing: 2px;
}

.grouped-window-list-item-label {
  width: 15em;
  min-width: 5px;
}

.grouped-window-list-item-box {
  padding: 0 6px;
  margin: 2px;
  border-radius: 6px;
  color: @subtext0@;
}

.grouped-window-list-item-box.top,
.grouped-window-list-item-box.bottom {
  border-bottom-width: 2px;
}

.grouped-window-list-item-box.right {
  padding-left: 0;
  padding-right: 0;
  border-right-width: 2px;
}

.grouped-window-list-item-box.right StBin {
  padding-right: 0;
}

.grouped-window-list-item-box.left {
  padding-left: 0;
  padding-right: 0;
  border-left-width: 2px;
}

.grouped-window-list-item-box.left StBin {
  padding-left: 1px;
}

.grouped-window-list-item-box:hover {
  background-color: @surface0@;
  color: @text@;
}

.grouped-window-list-item-box:focus {
  background-color: @surface1@;
  color: @text@;
  box-shadow: inset 0 -2px 0 @accent@;
}

.grouped-window-list-item-box:active {
  background-color: @surface1@;
  color: @text@;
  box-shadow: inset 0 -2px 0 @accent@;
}

.grouped-window-list-item-box.left:focus,
.grouped-window-list-item-box.left:active {
  box-shadow: inset 2px 0 0 @accent@;
}

.grouped-window-list-item-box.right:focus,
.grouped-window-list-item-box.right:active {
  box-shadow: inset -2px 0 0 @accent@;
}

.grouped-window-list-item-box .progress {
  background-color: @green_a80@;
}

.grouped-window-list-item-demands-attention {
  background-color: @yellow_a30@;
  color: @text@;
}

.grouped-window-list-thumbnail-label {
  padding-left: 4px;
}

.grouped-window-list-thumbnail-alert {
  background-color: @red_a30@;
}

.grouped-window-list-thumbnail-menu {
  border: 1px solid @surface1@;
  margin: 6px;
  background-color: @menu_bg@;
  border-radius: 8px;
  box-shadow: 0 2px 8px 0 @shadow@;
}

.grouped-window-list-thumbnail-menu > StBoxLayout {
  padding: 4px;
}

.grouped-window-list-thumbnail-menu .item-box {
  padding: 10px;
  spacing: 4px;
  border-radius: 0;
}

.grouped-window-list-thumbnail-menu .item-box:first-child {
  border-radius: 8px 0 0 8px;
}

.grouped-window-list-thumbnail-menu .item-box:last-child {
  border-radius: 0 8px 8px 0;
}

.grouped-window-list-thumbnail-menu .item-box:only-child,
.grouped-window-list-thumbnail-menu .item-box:first-child:last-child {
  border-radius: 8px;
}

.grouped-window-list-thumbnail-menu .item-box:outlined {
  border: 2px solid @accent_a60@;
}

.grouped-window-list-thumbnail-menu .item-box:selected {
  background-color: @surface0@;
}

.grouped-window-list-thumbnail-menu .thumbnail {
  width: 256px;
}

.grouped-window-list-thumbnail-menu .separator {
  width: 1px;
  background-color: @surface1@;
}

.grouped-window-list-button-label {
  padding-left: 4px;
}

.grouped-window-list-number-label {
  font-size: 0.75em;
}

.grouped-window-list-badge {
  border-radius: 99px;
  background-color: @surface1@;
  color: @text@;
}

.grouped-window-list-notifications-badge {
  border-radius: 99px;
  background-color: @red@;
  color: @on_accent@;
}

.grouped-window-list-notifications-badge-label {
  font-size: 0.75em;
}

.grouped-window-list-scrollbox-scrollview.vfade {
  -st-vfade-offset: 68px;
  -st-hfade-offset: 0;
}

.grouped-window-list-scrollbox-scrollview.hfade {
  -st-hfade-offset: 68px;
  -st-vfade-offset: 0;
}

.grouped-window-list-scrollbox-button {
  transition-duration: 100ms;
  border-radius: 6px;
  color: @subtext0@;
}

.grouped-window-list-scrollbox-button-icon {
  icon-size: 1.1em;
  color: inherit;
}

.grouped-window-list-scrollbox-button-start {
  margin-right: 1px;
}

.grouped-window-list-scrollbox-button-start.vertical {
  margin-right: 0;
  margin-bottom: 1px;
}

.grouped-window-list-scrollbox-button-end {
  margin-left: 1px;
}

.grouped-window-list-scrollbox-button-end.vertical {
  margin-left: 0;
  margin-top: 1px;
}

.grouped-window-list-scrollbox-button:hover {
  background-color: @surface0@;
  color: @text@;
}

.grouped-window-list-scrollbox-button:active {
  background-color: @surface1@;
  color: @text@;
}

/* Classic window list */

.window-list-box {
  spacing: 6px;
  padding-left: 6px;
  padding-top: 1px;
}

.window-list-box.vertical {
  spacing: 4px;
  padding: 6px 0;
}

.window-list-box:highlight {
  background-color: @red_a50@;
}

.window-list-item-box {
  padding: 0 6px;
  margin: 2px;
  border-radius: 6px;
  color: @subtext0@;
}

.window-list-item-box.top,
.window-list-item-box.bottom {
  border-bottom-width: 2px;
}

.window-list-item-box.top StLabel,
.window-list-item-box.bottom StLabel {
  padding-left: 2px;
}

.window-list-item-box.right {
  padding-left: 0;
  padding-right: 0;
  border-right-width: 2px;
}

.window-list-item-box.right StBin {
  padding-right: 0;
  padding-left: 5px;
}

.window-list-item-box.left {
  padding-left: 0;
  padding-right: 0;
  border-left-width: 2px;
}

.window-list-item-box.left StBin {
  padding-left: 0;
  padding-right: 5px;
}

.window-list-item-box:hover {
  background-color: @surface0@;
  color: @text@;
}

.window-list-item-box:focus {
  background-color: @surface1@;
  color: @text@;
  box-shadow: inset 0 -2px 0 @accent@;
}

.window-list-item-box:active {
  background-color: @surface1@;
  color: @text@;
  box-shadow: inset 0 -2px 0 @accent@;
}

.window-list-item-box.left:focus,
.window-list-item-box.left:active {
  box-shadow: inset 2px 0 0 @accent@;
}

.window-list-item-box.right:focus,
.window-list-item-box.right:active {
  box-shadow: inset -2px 0 0 @accent@;
}

.window-list-item-box .progress {
  background-color: @green_a80@;
}

.window-list-item-demands-attention {
  background-color: @yellow_a30@;
  color: @text@;
}

.window-list-preview {
  border: 1px solid @surface1@;
  background-color: @menu_bg@;
  border-radius: 8px;
  padding: 12px;
  spacing: 4px;
  box-shadow: 0 2px 8px 0 @shadow@;
}

/* ---------------------------------------------------------------------------
   Alt-Tab switcher
   ------------------------------------------------------------------------- */

#altTabPopup {
  padding: 8px;
  spacing: 16px;
}

.switcher-list {
  background-color: @menu_bg@;
  border: 1px solid @surface1@;
  border-radius: 16px;
  box-shadow: 0 4px 12px 2px @shadow@;
  padding: 16px;
  color: @text@;
}

.switcher-list-item-container {
  spacing: 12px;
}

.switcher-list .item-box {
  padding: 8px;
  border: 1px solid transparent;
  border-radius: 8px;
  background-color: transparent;
}

.switcher-list .item-box:outlined {
  border-color: @accent@;
}

.switcher-list .item-box:selected {
  border-color: @surface1@;
  background-color: @surface0@;
}

.switcher-list .thumbnail-box {
  padding: 0;
  spacing: 4px;
}

.switcher-list .thumbnail {
  width: 256px;
}

.switcher-preview-backdrop {
  background-color: @backdrop@;
}

.switcher-arrow {
  background-color: transparent;
  border-color: transparent;
  color: @text@;
}

.thumbnail-scroll-gradient-left {
  background-gradient-direction: horizontal;
  background-gradient-start: @menu_bg@;
  background-gradient-end: @menu_bg_a00@;
  border-radius: 16px;
  border-radius-topright: 0;
  border-radius-bottomright: 0;
  width: 60px;
}

.thumbnail-scroll-gradient-right {
  background-gradient-direction: horizontal;
  background-gradient-start: @menu_bg_a00@;
  background-gradient-end: @menu_bg@;
  border-radius: 16px;
  border-radius-topleft: 0;
  border-radius-bottomleft: 0;
  width: 60px;
}

/* ---------------------------------------------------------------------------
   Notifications
   ------------------------------------------------------------------------- */

#notification {
  width: 34em;
  border-radius: 12px;
  border: 1px solid @surface1@;
  background-color: @notification_bg@;
  color: @text@;
  padding: 12px;
  margin-from-right-edge-of-screen: 20px;
  spacing-rows: 10px;
  spacing-columns: 10px;
  box-shadow: 0 4px 12px 2px @shadow@;
}

#notification.multi-line-notification {
  padding-bottom: 12px;
  color: @text@;
}

#notification-body {
  spacing: 6px;
}

#notification-actions {
  spacing: 12px;
}

.notification-with-image {
  min-height: 159px;
}

.notification-button {
  padding: 6px 12px;
}

.notification-icon-button {
  padding: 6px;
}

.notification-icon-button StIcon {
  icon-size: 16px;
}

/* ---------------------------------------------------------------------------
   On-screen displays
   ------------------------------------------------------------------------- */

.media-keys-osd {
  color: @text@;
  background-color: @osd_bg@;
  border: 1px solid @surface1@;
  border-radius: 99px;
  text-align: center;
  padding: 12px 24px;
  margin-bottom: 1em;
  font-weight: bold;
  font-size: 13pt;
  spacing: 12px;
  box-shadow: 0 4px 12px 2px @shadow@;
}

.media-keys-osd > * {
  spacing: 12px;
}

.media-keys-osd StIcon {
  icon-size: 32px;
  color: @text@;
}

.media-keys-osd StLabel:ltr {
  margin-right: 6px;
}

.media-keys-osd StLabel:rtl {
  margin-left: 6px;
}

.media-keys-osd .level {
  min-width: 160px;
  -barlevel-height: 6px;
  -barlevel-background-color: @surface1@;
  -barlevel-active-background-color: @accent@;
  -barlevel-amplify-color: @yellow@;
  -barlevel-amplify-separator-width: 3px;
}

.media-keys-osd .level:ltr {
  margin-right: 6px;
}

.media-keys-osd .level:rtl {
  margin-left: 6px;
}

.media-keys-osd .level-bar {
  border-radius: 8px;
  background-color: @accent@;
}

.info-osd {
  color: @text@;
  background-color: @osd_bg@;
  border: 1px solid @surface1@;
  border-radius: 8px;
  text-align: center;
  padding: 16px;
  font-size: 1.1em;
  font-weight: 700;
  box-shadow: 0 4px 12px 2px @shadow@;
}

.workspace-switch-osd {
  color: @text@;
  background-color: @osd_bg@;
  border: 1px solid @surface1@;
  border-radius: 99px;
  text-align: center;
  min-width: 140px;
  margin-bottom: 1em;
  font-weight: bold;
  font-size: 13pt;
  padding: 12px 36px 0 36px;
  box-shadow: 0 4px 12px 2px @shadow@;
}

.workspace-switch-osd-indicator-box {
  spacing: 12px;
}

.workspace-switch-osd-indicator {
  background-color: @overlay1@;
  padding: 3px;
  margin: 14px;
  border-radius: 99px;
}

.workspace-switch-osd-indicator:active {
  background-color: @accent@;
  padding: 5px;
  margin: 12px;
}

.resize-popup {
  color: @text@;
  background-color: @osd_bg@;
  border: 1px solid @surface1@;
  border-radius: 8px;
  text-align: center;
  padding: 12px;
  box-shadow: 0 4px 12px 2px @shadow@;
}

/* ---------------------------------------------------------------------------
   Calendar
   ------------------------------------------------------------------------- */

.calendar {
  margin-top: 20px;
  spacing-rows: 2px;
  spacing-columns: 2px;
  color: @text@;
}

.calendar-main-box {
  margin: 8px;
}

.calendar-events-main-box {
  height: 300px;
  margin-right: 16px;
  min-width: 350px;
  border-right: 1px solid @surface1@;
}

.calendar-today-home-button,
.calendar-today-home-button-enabled {
  margin-left: 12px;
  padding: 8px 12px;
  border-radius: 8px;
  color: @text@;
}

.calendar-today-home-button:hover,
.calendar-today-home-button-enabled:hover {
  background-color: @surface0@;
}

.calendar-today-day-label {
  font-weight: 700;
  font-size: 13pt;
  text-align: center;
  color: @text@;
}

.calendar-today-date-label {
  font-weight: 700;
  font-size: 15pt;
  color: @text@;
}

.calendar-month-label {
  font-weight: 700;
  font-size: 11pt;
  color: @text@;
}

.calendar-change-month-back,
.calendar-change-month-forward:rtl {
  width: 16px;
  height: 16px;
  color: @text@;
  background-image: url("calendar-arrow-left.svg");
}

.calendar-change-month-back:hover,
.calendar-change-month-forward:rtl:hover {
  background-image: url("calendar-arrow-left-hover.svg");
}

.calendar-change-month-forward,
.calendar-change-month-back:rtl {
  width: 16px;
  height: 16px;
  color: @text@;
  background-image: url("calendar-arrow-right.svg");
}

.calendar-change-month-forward:hover,
.calendar-change-month-back:rtl:hover {
  background-image: url("calendar-arrow-right-hover.svg");
}

.calendar-day-event-dot-box {
  margin-top: 1.7em;
  max-rows: 1;
}

.calendar-day-event-dot {
  margin: 1px;
  border-radius: 2px;
  width: 4px;
  height: 4px;
  background-color: @accent@;
}

.calendar-day-base {
  text-align: center;
  width: 2.4em;
  height: 2.4em;
  border-radius: 99px;
  color: @subtext0@;
}

.calendar-day-base:hover {
  background-color: @surface0@;
  color: @text@;
}

.calendar-day-heading {
  color: @subtext1@;
  margin-top: 12px;
  height: 1.6em;
}

.calendar-work-day {
  color: @text@;
}

.calendar-nonwork-day {
  color: @text@;
}

.calendar-week-number {
  color: @insensitive@;
}

.calendar-today {
  box-shadow: inset 0 0 0 2px @accent@;
  background-color: @surface0@;
  color: @text@;
}

.calendar-today:hover {
  background-color: @surface1@;
}

.calendar-other-month-day {
  color: @insensitive@;
}

.calendar-not-today:selected {
  background-color: @surface0@;
  color: @text@;
}

.calendar-events-date-label {
  font-weight: 700;
  font-size: 13pt;
  text-align: center;
  color: @text@;
}

.calendar-events-no-events-button {
  margin: 6px 0;
  padding: 6px;
  border-radius: 8px;
  color: @subtext0@;
}

.calendar-events-no-events-button:hover {
  color: @text@;
}

.calendar-events-no-events-icon {
  color: @overlay0@;
  icon-size: 128px;
}

.calendar-events-no-events-label {
  font-weight: 700;
  font-size: 15pt;
  text-align: center;
  color: @subtext0@;
  margin-top: 16px;
}

.calendar-events-scrollbox {
  margin-top: 8px;
}

.calendar-events-main-box .separator {
  -margin-horizontal: 1em;
  -gradient-height: 1px;
  -gradient-start: transparent;
  -gradient-end: transparent;
}

.calendar-event-button {
  margin: 3px 0;
  border-radius: 8px;
  border: 1px solid transparent;
}

.calendar-event-button:hover {
  background-color: @surface0@;
  border-color: @surface1@;
}

.calendar-event-color-strip {
  width: 3px;
  background-color: @accent@;
}

.calendar-event-row-content {
  margin: 7px;
}

.calendar-event-time-past {
  font-weight: 700;
  font-size: 11pt;
  color: @insensitive@;
}

.calendar-event-time-present {
  font-weight: 700;
  font-size: 11pt;
  color: @text@;
}

.calendar-event-time-present:all-day {
  color: @accent@;
}

.calendar-event-countdown {
  font-weight: 400;
  font-size: 9pt;
  color: @subtext0@;
}

.calendar-event-countdown:soon {
  color: @text_warning@;
}

.calendar-event-countdown:imminent {
  color: @text_error@;
}

.calendar-event-countdown:current {
  color: @text_success@;
}

.calendar-event-time-future {
  font-weight: 700;
  font-size: 11pt;
  color: @text@;
}

.calendar-event-summary {
  color: @subtext0@;
}

/* ---------------------------------------------------------------------------
   Dialogs
   ------------------------------------------------------------------------- */

.dialog {
  color: @text@;
  background-color: @menu_bg@;
  border: 1px solid @menu_border@;
  border-radius: 18px;
  padding: 18px;
  box-shadow: 0 8px 24px 4px @shadow@;
}

.dialog .dialog-content-box {
  margin-top: 8px;
  margin-bottom: 16px;
  spacing: 32px;
  max-width: 28em;
}

.dialog .dialog-button {
  font-weight: bold;
  padding: 12px;
  border-radius: 12px;
}

.dialog .confirm-dialog-title {
  font-weight: 800;
  font-size: 15pt;
  text-align: center;
  color: @text@;
}

.dialog-list {
  spacing: 18px;
}

.dialog-list .dialog-list-title {
  font-weight: 700;
  font-size: 11pt;
  text-align: center;
  color: @text@;
}

.dialog-list .dialog-list-scrollview {
  max-height: 200px;
}

.dialog-list .dialog-list-box {
  spacing: 1em;
  border-radius: 8px;
}

.dialog-list .dialog-list-box .dialog-list-item {
  spacing: 1em;
  border-radius: 8px;
  padding: 6px 12px;
  transition-duration: 100ms;
  color: @text@;
}

.dialog-list .dialog-list-box .dialog-list-item:hover {
  background-color: @surface0@;
}

.dialog-list .dialog-list-box .dialog-list-item:selected {
  background-color: @accent@;
  color: @on_accent@;
}

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-title {
  font-weight: bold;
}

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-description {
  font-size: 9pt;
  color: @subtext0@;
}

.dialog-list .dialog-list-box .dialog-list-item:selected .dialog-list-item-description {
  color: @on_accent@;
}

.end-session-dialog {
  min-width: 40em;
}

.end-session-dialog .dialog-content-box {
  spacing: 0;
}

.end-session-dialog .dialog-list {
  spacing: 0;
}

.end-session-dialog .dialog-list .dialog-list-title {
  color: @text_warning@;
  background-color: @yellow_a10@;
  padding: 9px;
  border-radius: 8px;
  margin: 4px 0;
}

.message-dialog-content {
  spacing: 18px;
}

.message-dialog-content .message-dialog-title {
  text-align: center;
  font-weight: 800;
  font-size: 15pt;
  color: @text@;
}

.message-dialog-content .message-dialog-title.lightweight {
  font-weight: 700;
  font-size: 13pt;
}

.message-dialog-content .message-dialog-description {
  text-align: center;
  color: @text@;
}

.message-dialog-content .message-dialog-caption {
  font-size: 9pt;
  text-align: center;
  color: @subtext0@;
}

.run-dialog .dialog-content-box {
  margin: 4px;
}

.run-dialog-description {
  font-size: 9pt;
  text-align: center;
  color: @subtext0@;
}

.run-dialog-description.error {
  color: @text_error@;
}

.run-dialog-completion-box {
  padding-top: 6px;
  padding-left: 12px;
}

.prompt-dialog {
  width: 26em;
}

.prompt-dialog .dialog-content-box {
  spacing: 16px;
  margin-bottom: 12px;
}

.prompt-dialog-password-layout {
  spacing: 8px;
}

.prompt-dialog-error-label,
.prompt-dialog-info-label,
.prompt-dialog-null-label {
  text-align: center;
  font-size: 9pt;
}

.prompt-dialog-error-label {
  color: @text_error@;
}

.prompt-dialog-info-label,
.prompt-dialog-null-label {
  color: @subtext0@;
}

.polkit-dialog-user-layout {
  text-align: center;
  spacing: 2px;
}

.polkit-dialog-user-combo {
  font-weight: 700;
  font-size: 11pt;
  border-radius: 8px;
  padding: 6px 36px;
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
}

.polkit-dialog-user-combo:hover {
  background-color: @surface1@;
}

.polkit-dialog-user-combo:insensitive {
  color: @text@;
  background-color: transparent;
  border-color: transparent;
}

.processes-dialog .dialog-content-box .dialog-list .dialog-list-box {
  background-color: @mantle@;
  spacing: 0;
}

.processes-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item {
  border-radius: 0;
}

.processes-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item:first-child {
  border-radius: 8px 8px 0 0;
}

.processes-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item:last-child {
  border-radius: 0 0 8px 8px;
}

.autorun-dialog {
  min-width: 30em;
}

.autorun-dialog .dialog-content-box {
  margin-top: 4px;
  margin-bottom: 12px;
  spacing: 12px;
  max-width: 28em;
}

.autorun-dialog .dialog-content-box .dialog-list .dialog-list-box {
  background-color: @mantle@;
  spacing: 0;
}

.autorun-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item {
  border-radius: 0;
}

.autorun-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item:first-child {
  border-radius: 8px 8px 0 0;
}

.autorun-dialog .dialog-content-box .dialog-list .dialog-list-box .dialog-list-item:last-child {
  border-radius: 0 0 8px 8px;
}

.autorun-dialog .autorun-dialog-heading {
  font-weight: 800;
  font-size: 15pt;
  text-align: center;
  color: @text@;
}

.autorun-dialog .autorun-dialog-subheading {
  font-weight: 700;
  font-size: 13pt;
  text-align: center;
  color: @subtext0@;
}

.popup-dialog {
  color: @text@;
}

.hover-click-dialog {
  padding: 6px;
  border-radius: 12px;
}

.hover-click-dialog .dialog-content-box {
  margin: 0;
  spacing: 0;
  max-width: auto;
}

.hover-click-header {
  height: 20px;
}

.hover-click-box,
.hover-click-actions {
  spacing: 4px;
}

.hover-click-button {
  padding: 6px;
  border-radius: 8px;
  color: @text@;
  background-color: transparent;
  border: 1px solid transparent;
}

.hover-click-button:hover {
  background-color: @surface0@;
}

.hover-click-button:checked {
  background-color: @accent@;
  color: @on_accent@;
  border-color: @accent@;
}

.hover-click-button:checked:hover {
  background-color: @accent_hover@;
  border-color: @accent_hover@;
}

.hover-click-button-box {
  spacing: 4px;
}

.hover-click-button-label {
  text-align: center;
}

.hover-click-separator {
  background-color: @surface1@;
}

.hover-click-box.vertical .hover-click-separator {
  height: 1px;
  margin: 4px 0;
}

.hover-click-box.horizontal .hover-click-separator {
  width: 1px;
  margin: 0 4px;
}

.hover-click-lock-button {
  padding: 6px;
  border-radius: 8px;
  color: @text@;
  background-color: transparent;
  border: 1px solid transparent;
}

.hover-click-lock-button:hover {
  background-color: @surface0@;
}

/* ---------------------------------------------------------------------------
   Toggles, check boxes and radio buttons
   ------------------------------------------------------------------------- */

.toggle-switch {
  height: 26px;
  width: 46px;
  background-size: contain;
  background-image: url("toggle-off.svg");
}

.toggle-switch:checked {
  background-image: url("toggle-on.svg");
}

.check-box StBoxLayout {
  spacing: 0.8em;
}

.check-box StBin {
  width: 20px;
  height: 20px;
  background-size: contain;
  background-image: url("checkbox-off.svg");
}

.check-box:focus StBin {
  background-image: url("checkbox-off.svg");
}

.check-box:checked StBin {
  background-image: url("checkbox.svg");
}

.check-box:focus:checked StBin {
  background-image: url("checkbox.svg");
}

.radiobutton StBoxLayout {
  spacing: 0.8em;
}

.radiobutton StBin {
  width: 20px;
  height: 20px;
  background-size: contain;
  background-image: url("radio-off.svg");
}

.radiobutton:focus StBin {
  background-image: url("radio-off.svg");
}

.radiobutton:checked StBin {
  background-image: url("radio.svg");
}

.radiobutton:focus:checked StBin {
  background-image: url("radio.svg");
}

/* ---------------------------------------------------------------------------
   On-screen keyboard
   ------------------------------------------------------------------------- */

#virtual-keyboard {
  background-color: @panel@;
}

.vkeyboard-key-container {
  padding: 4px;
  spacing: 4px;
}

.vkeyboard-key {
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
  border-radius: 11px;
  font-size: 15pt;
}

.vkeyboard-key:focus {
  box-shadow: inset 0 0 1px 2px @accent@;
}

.vkeyboard-key:hover,
.vkeyboard-key:checked {
  background-color: @surface1@;
}

.vkeyboard-key:active {
  background-color: @surface2@;
}

.vkeyboard-key.shift-key-lowercase,
.vkeyboard-key.escape-key,
.vkeyboard-key.hide-key,
.vkeyboard-key.non-alpha-key {
  background-color: @mantle@;
}

.vkeyboard-key.shift-key-lowercase:hover,
.vkeyboard-key.escape-key:hover,
.vkeyboard-key.hide-key:hover,
.vkeyboard-key.non-alpha-key:hover {
  background-color: @surface0@;
}

.vkeyboard-key.shift-key-uppercase {
  background-color: @surface2@;
}

.vkeyboard-key.enter-key {
  color: @on_accent@;
  background-color: @accent@;
  border-color: @accent@;
}

.vkeyboard-key.modifier-key {
  background-color: @mantle@;
}

.vkeyboard-key.modifier-key:hover,
.vkeyboard-key.modifier-key:checked {
  background-color: @surface0@;
}

.vkeyboard-key.modifier-key:latched {
  background-color: @surface2@;
}

.vkeyboard-key StIcon {
  icon-size: 1.125em;
}

.vkeyboard-subkeys {
  color: @text@;
  -arrow-border-radius: 8px;
  -arrow-background-color: @menu_bg@;
  -arrow-border-width: 1px;
  -arrow-border-color: @surface1@;
  -arrow-base: 20px;
  -arrow-rise: 10px;
  -boxpointer-gap: 6px;
}

.word-suggestions {
  font-size: 14pt;
  spacing: 20px;
  min-height: 20pt;
  color: @text@;
}

/* ---------------------------------------------------------------------------
   Expo and window overview
   ------------------------------------------------------------------------- */

.workspace-thumbnails {
  spacing: 26px;
}

.workspace-thumbnails-background {
  padding: 8px;
}

.workspace-add-button {
  background-image: url("add-workspace.svg");
  height: 200px;
  width: 35px;
  transition-duration: 150ms;
}

.workspace-add-button:hover {
  background-image: url("add-workspace-hover.svg");
}

.workspace-close-button {
  background-image: url("close.svg");
  height: 26px;
  width: 26px;
  -cinnamon-close-overlap: 13px;
}

.expo-background {
  background-color: @mantle@;
}

.expo-workspace-thumbnail-frame {
  border: 1px solid @surface1@;
  border-radius: 8px;
}

.expo-workspace-thumbnail-frame#active {
  border-color: @accent@;
  border-width: 2px;
}

.expo-workspaces-name-entry {
  height: 1.5em;
}

.window-close-area {
  background-image: url("trash-icon.svg");
  height: 120px;
  width: 400px;
}

.window-close {
  background-image: url("close.svg");
  height: 26px;
  width: 26px;
  -cinnamon-close-overlap: 13px;
}

.window-border {
  border: 3px solid @accent@;
  border-radius: 8px;
}

.window-caption {
  min-height: 22px;
  border-radius: 8px;
  padding: 6px 9px;
  spacing: 4px;
  border: 1px solid @surface1@;
  background-color: @surface0@;
  color: @text@;
  -cinnamon-caption-spacing: 6px;
}

.window-caption:focus {
  background-color: @surface1@;
}

#overview {
  spacing: 12px;
}

.overview-empty-placeholder {
  font-weight: 300;
  font-size: 24pt;
  color: @text@;
}

/* ---------------------------------------------------------------------------
   Desklets
   ------------------------------------------------------------------------- */

.desklet:highlight {
  border: 2px solid @accent@;
  border-radius: 8px;
}

.desklet-with-borders {
  border: 1px solid @surface1@;
  border-radius: 8px;
  background-color: @base_a90@;
  color: @text@;
}

.desklet-with-borders-and-header {
  border: 1px solid @surface1@;
  border-radius: 0 0 8px 8px;
  border-top-width: 0;
  background-color: @base_a90@;
  color: @text@;
  padding: 12px;
}

.desklet-header {
  border: 1px solid @surface1@;
  border-radius: 8px 8px 0 0;
  background-color: @mantle_a90@;
  color: @text@;
  padding: 6px;
}

.desklet-drag-placeholder {
  border: 1px solid @accent@;
  background-color: @accent_a20@;
}

.photoframe-box {
  border: 1px solid @surface1@;
  border-radius: 8px;
  background-color: @base_a90@;
  padding: 6px;
}

.clock-desklet-label {
  color: @text@;
}

/* ---------------------------------------------------------------------------
   Screensaver and lock screen
   ------------------------------------------------------------------------- */

.screen-shield {
  background-color: @crust@;
  color: @text@;
}

.screen-shield .screen-shield-background {
  background-color: @crust@;
}

.screen-shield .icon-button {
  padding: 16px;
  border: 1px solid @text_a10@;
  background-color: @text_a15@;
  margin-left: 6px;
  margin-right: 6px;
}

.screen-shield .icon-button:hover {
  background-color: @text_a25@;
}

.screen-shield .prompt-dialog {
  width: 34em;
  background-color: @base_a95@;
  border: 1px solid @surface1@;
  padding: 18px;
  spacing: 24px;
  border-radius: 18px;
}

.screen-shield .prompt-dialog .user-widget-label {
  font-weight: 400;
  font-size: 20pt;
  margin-bottom: 0.75em;
  color: @text@;
}

.screen-shield .prompt-dialog .user-icon {
  icon-size: 128px;
  border: 2px solid @surface1@;
}

.screen-shield .prompt-dialog .user-icon StIcon {
  padding: 30px;
}

.screen-shield .prompt-dialog-password-entry {
  width: 20em;
  background-color: @surface0@;
  border-color: @surface1@;
}

.screen-shield .clock-widget {
  padding: 6px;
  spacing: 6px;
}

.screen-shield .clock-widget .clock-time-label {
  font-size: 72pt;
  font-weight: 300;
  color: @text@;
}

.screen-shield .clock-widget .clock-date-label {
  font-weight: 800;
  font-size: 20pt;
  color: @text@;
}

.screen-shield .clock-widget .clock-message-label {
  font-size: 14pt;
  color: @subtext0@;
  margin-top: 4px;
}

.screen-shield .clock-widget .clock-message-author {
  font-size: 12pt;
  color: @overlay1@;
  text-align: center;
}

.screen-shield .albumart-widget {
  padding: 12px;
  spacing: 12px;
  min-width: 400px;
  background-color: @base_a90@;
  border: 1px solid @surface1@;
  border-radius: 18px;
}

.screen-shield .albumart-widget .albumart-track-info-box {
  spacing: 3px;
  max-width: 300px;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-title {
  font-weight: 700;
  font-size: 15pt;
  color: @text@;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-artist {
  font-weight: 700;
  font-size: 13pt;
  color: @text@;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-album {
  font-weight: 700;
  font-size: 11pt;
  color: @subtext0@;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-controls {
  spacing: 6px;
  padding-top: 6px;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-controls .icon-button {
  padding: 8px;
  border: 1px solid @text_a10@;
  background-color: @text_a15@;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box {
  spacing: 6px;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box .albumart-volume-icon {
  icon-size: 16px;
  color: @text@;
}

.screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box .albumart-volume-slider {
  height: 20px;
  min-width: 280px;
  -slider-height: 4px;
  -slider-background-color: @surface1@;
  -slider-border-color: transparent;
  -slider-active-background-color: @accent@;
  -slider-active-border-color: transparent;
  -slider-border-width: 0;
  -slider-handle-radius: 8px;
}

.screen-shield .info-panel {
  padding: 8px;
  spacing: 12px;
}

.screen-shield .info-panel .notification-widget {
  spacing: 4px;
}

.screen-shield .info-panel .notification-widget .notification-widget-label {
  color: @text@;
  font-size: 12pt;
  font-weight: bold;
}

.screen-shield .info-panel .notification-widget .notification-widget-icon {
  color: @text@;
}

.screen-shield .info-panel .power-widget-icon {
  color: @text@;
}

.screen-shield .info-panel .power-widget-icon-critical {
  color: @text_error@;
}

/* ---------------------------------------------------------------------------
   IBus candidate popup
   ------------------------------------------------------------------------- */

.candidate-popup-boxpointer {
  -arrow-border-radius: 12px;
  -arrow-background-color: @menu_bg@;
  -arrow-border-width: 1px;
  -arrow-border-color: @menu_border@;
  -arrow-base: 24px;
  -arrow-rise: 12px;
  -arrow-box-shadow: 0 2px 6px @shadow_soft@;
}

.candidate-popup-content {
  padding: 0.5em;
  spacing: 0.3em;
  color: @text@;
}

.candidate-index {
  padding: 0 0.5em 0 0;
  color: @subtext0@;
}

.candidate-box {
  padding: 0.3em 0.5em;
  border-radius: 8px;
  color: @text@;
}

.candidate-box:selected,
.candidate-box:hover {
  background-color: @surface0@;
}

.candidate-page-button-box {
  height: 2em;
}

.vertical .candidate-page-button-box {
  padding-top: 0.5em;
}

.horizontal .candidate-page-button-box {
  padding-left: 0.5em;
}

.candidate-page-button {
  padding: 4px;
  color: @text@;
  background-color: @surface0@;
  border: 1px solid @surface1@;
}

.candidate-page-button-previous {
  border-radius: 8px 0 0 8px;
  border-right-width: 0;
}

.candidate-page-button-next {
  border-radius: 0 8px 8px 0;
}

.candidate-page-button-icon {
  icon-size: 1em;
}
