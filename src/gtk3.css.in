/* ============================================================================
   Catppuccin @flavor@ for GTK 3
   Palette: https://catppuccin.com/palette/
   Generated from src/gtk3.css.in by scripts/build.py
   Do not edit this file directly: edit the template and rebuild.

   The theme imports Adwaita for widget geometry and the long tail of
   applications, then re-colors the standard GTK widgets with the Catppuccin
   palette. Keeping Adwaita as the base means a missing selector degrades to a
   working widget rather than an unstyled one.
   ========================================================================== */

@import url("resource:///org/gtk/libgtk/theme/Adwaita/@gtk3_sheet@");

/* ---------------------------------------------------------------------------
   Palette
   ------------------------------------------------------------------------- */

@define-color catppuccin_rosewater @rosewater@;
@define-color catppuccin_flamingo @flamingo@;
@define-color catppuccin_pink @pink@;
@define-color catppuccin_mauve @mauve@;
@define-color catppuccin_red @red@;
@define-color catppuccin_maroon @maroon@;
@define-color catppuccin_peach @peach@;
@define-color catppuccin_yellow @yellow@;
@define-color catppuccin_green @green@;
@define-color catppuccin_teal @teal@;
@define-color catppuccin_sky @sky@;
@define-color catppuccin_sapphire @sapphire@;
@define-color catppuccin_blue @blue@;
@define-color catppuccin_lavender @lavender@;
@define-color catppuccin_text @text@;
@define-color catppuccin_subtext1 @subtext1@;
@define-color catppuccin_subtext0 @subtext0@;
@define-color catppuccin_overlay2 @overlay2@;
@define-color catppuccin_overlay1 @overlay1@;
@define-color catppuccin_overlay0 @overlay0@;
@define-color catppuccin_surface2 @surface2@;
@define-color catppuccin_surface1 @surface1@;
@define-color catppuccin_surface0 @surface0@;
@define-color catppuccin_base @base@;
@define-color catppuccin_mantle @mantle@;
@define-color catppuccin_crust @crust@;
@define-color catppuccin_accent @accent@;

/* Adwaita named colors, redefined after the import. */
@define-color theme_bg_color @base@;
@define-color theme_fg_color @text@;
@define-color theme_base_color @base@;
@define-color theme_text_color @text@;
@define-color theme_selected_bg_color @accent@;
@define-color theme_selected_fg_color @on_accent@;
@define-color theme_unfocused_bg_color @mantle@;
@define-color theme_unfocused_fg_color @subtext0@;
@define-color theme_unfocused_base_color @base@;
@define-color theme_unfocused_text_color @text@;
@define-color theme_unfocused_selected_bg_color @accent@;
@define-color theme_unfocused_selected_fg_color @on_accent@;
@define-color insensitive_bg_color @mantle@;
@define-color insensitive_fg_color @overlay1@;
@define-color insensitive_base_color @surface0@;
@define-color borders @surface0@;
@define-color unfocused_borders @surface0@;
@define-color warning_color @text_warning@;
@define-color error_color @text_error@;
@define-color success_color @text_success@;
@define-color link_color @link@;
@define-color visited_link_color @mauve@;
@define-color content_view_bg @base@;
@define-color text_view_bg @base@;
@define-color wm_bg @crust@;
@define-color wm_border @surface0@;
@define-color wm_title @text@;
@define-color wm_unfocused_title @subtext0@;
@define-color wm_highlight @crust@;
@define-color wm_button_hover_color_a @surface0@;
@define-color wm_button_hover_color_b @surface1@;
@define-color wm_button_active_color_a @surface1@;
@define-color wm_button_active_color_b @surface2@;
@define-color popover_bg_color @mantle@;
@define-color popover_fg_color @text@;
@define-color headerbar_bg_color @crust@;
@define-color headerbar_fg_color @text@;
@define-color headerbar_border_color @surface0@;
@define-color headerbar_backdrop_color @mantle@;
@define-color headerbar_shade_color @shadow@;
@define-color card_bg_color @surface0@;
@define-color card_fg_color @text@;
@define-color window_bg_color @base@;
@define-color window_fg_color @text@;
@define-color view_bg_color @base@;
@define-color view_fg_color @text@;
@define-color sidebar_bg_color @mantle@;
@define-color sidebar_fg_color @text@;
@define-color secondary_sidebar_bg_color @crust@;
@define-color secondary_sidebar_fg_color @text@;
@define-color accent_bg_color @accent@;
@define-color accent_fg_color @on_accent@;
@define-color accent_color @accent@;
@define-color destructive_bg_color @red@;
@define-color destructive_fg_color @on_error@;
@define-color destructive_color @text_error@;
@define-color success_bg_color @green@;
@define-color success_fg_color @on_success@;
@define-color success_color @text_success@;
@define-color warning_bg_color @yellow@;
@define-color warning_fg_color @on_warning@;
@define-color warning_color @text_warning@;
@define-color error_bg_color @red@;
@define-color error_fg_color @on_error@;
@define-color error_color @text_error@;

/* ---------------------------------------------------------------------------
   Global
   ------------------------------------------------------------------------- */

* {
  outline-color: @accent@;
  outline-offset: -2px;
  -gtk-outline-radius: 6px;
  -GtkTextView-error-underline-color: @text_error@;
  -GtkScrolledWindow-scrollbar-spacing: 0;
}

*:focus {
  outline-style: solid;
  outline-width: 2px;
  outline-color: @accent@;
}

/* Adwaita draws several controls with literal gradients. The overrides below
   set flat Catppuccin colors, so remove the imported background images for the
   states we recolor. */
button,
button:hover,
button:active,
button:checked,
button:disabled,
button:backdrop,
button.flat,
button.flat:hover,
button.flat:active,
button.flat:checked,
button.suggested-action,
button.suggested-action:hover,
button.suggested-action:active,
button.destructive-action,
button.destructive-action:hover,
button.destructive-action:active,
entry,
entry:hover,
entry:focus,
entry:disabled,
entry:backdrop,
headerbar:backdrop,
.titlebar:backdrop,
toolbar,
switch,
switch:hover,
switch:active,
switch:checked,
switch:disabled,
switch:backdrop,
switch slider,
switch:hover slider,
switch:checked slider,
switch:disabled slider,
switch:backdrop slider,
scale trough,
scale highlight,
scale fill,
scale slider,
scale slider:hover,
scale slider:active,
scale slider:disabled,
scale slider:backdrop,
progressbar trough,
progressbar progress,
check,
radio,
check:hover,
radio:hover,
check:active,
radio:active,
check:checked,
radio:checked,
check:indeterminate,
radio:indeterminate,
check:disabled,
radio:disabled,
check:backdrop,
radio:backdrop,
treeview.view header button,
menubar,
menu,
notebook > header,
statusbar,
actionbar > revealer > box,
popover.background,
popover.background > contents,
.sidebar,
placessidebar,
calendar,
.osd,
button:backdrop:hover,
button:backdrop:disabled,
button:checked:hover,
button:checked:active,
button:checked:disabled,
button:checked:backdrop,
button.flat:backdrop,
button.flat:disabled,
button.suggested-action:disabled,
button.suggested-action:backdrop,
button.destructive-action:disabled,
button.destructive-action:backdrop,
check:checked:hover,
check:checked:active,
check:checked:disabled,
check:checked:backdrop,
check:indeterminate:hover,
check:indeterminate:active,
check:indeterminate:disabled,
check:indeterminate:backdrop,
check:backdrop:disabled,
radio:checked:hover,
radio:checked:active,
radio:checked:disabled,
radio:checked:backdrop,
radio:indeterminate:hover,
radio:indeterminate:active,
radio:indeterminate:disabled,
radio:indeterminate:backdrop,
radio:backdrop:disabled,
switch:checked:hover slider,
switch:checked:active slider,
switch:checked:disabled slider,
switch:checked:backdrop slider,
switch:backdrop:disabled slider,
scale slider:hover:active,
scale slider:backdrop:disabled,
infobar {
  background-image: none;
}

/* ---------------------------------------------------------------------------
   Windows and title bars
   ------------------------------------------------------------------------- */

window,
.background {
  background-color: @base@;
  color: @text@;
}

window:backdrop,
.background:backdrop {
  color: @subtext0@;
}

headerbar,
.titlebar {
  background-image: none;
  background-color: @crust@;
  color: @text@;
  border: none;
  border-bottom: 1px solid @surface0@;
  border-radius: 0;
  box-shadow: none;
  min-height: 38px;
  padding: 0 6px;
}

headerbar:backdrop,
.titlebar:backdrop {
  background-color: @mantle@;
  color: @subtext0@;
  border-bottom-color: @surface0@;
}

headerbar .title,
.titlebar .title {
  color: @text@;
  font-weight: 700;
}

headerbar .subtitle,
.titlebar .subtitle {
  color: @subtext0@;
  font-size: smaller;
}

headerbar:backdrop .title,
.titlebar:backdrop .title,
headerbar:backdrop .subtitle,
.titlebar:backdrop .subtitle {
  color: @subtext0@;
}

headerbar separator,
.titlebar separator {
  background-color: @surface0@;
}

.titlebutton,
headerbar button.titlebutton {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
  padding: 4px;
}

.titlebutton:hover,
headerbar button.titlebutton:hover {
  background-color: @surface0@;
}

.titlebutton.close:hover,
headerbar button.titlebutton.close:hover {
  background-color: @red@;
  color: @on_error@;
}

/* ---------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */

button {
  background-image: none;
  background-color: @surface0@;
  color: @text@;
  border: 1px solid @surface1@;
  border-radius: 6px;
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
  min-height: 22px;
  min-width: 16px;
  padding: 4px 10px;
  transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
}

button:hover {
  background-color: @surface1@;
  border-color: @surface2@;
}

button:active,
button:checked {
  background-color: @surface2@;
  border-color: @accent@;
}

button:disabled {
  background-color: @mantle@;
  color: @overlay1@;
  border-color: @surface0@;
}

button:backdrop {
  background-color: @mantle@;
  color: @subtext0@;
  border-color: @surface0@;
}

button:backdrop:hover {
  background-color: @surface0@;
}

button.flat,
button.flat:hover,
button.flat:active,
button.flat:checked,
button.flat:disabled {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

button.flat:hover {
  background-color: @surface0@;
}

button.flat:active,
button.flat:checked {
  background-color: @surface1@;
}

button.circular {
  border-radius: 999px;
  padding: 4px;
}

button.suggested-action {
  background-color: @accent@;
  color: @on_accent@;
  border-color: @accent@;
}

button.suggested-action:hover {
  background-color: @gtk_accent_hover@;
  border-color: @gtk_accent_hover@;
}

button.suggested-action:active,
button.suggested-action:checked {
  background-color: @gtk_accent_active@;
  border-color: @gtk_accent_active@;
}

button.suggested-action:disabled {
  background-color: @surface0@;
  color: @overlay1@;
  border-color: @surface1@;
}

button.destructive-action {
  background-color: @red@;
  color: @on_error@;
  border-color: @red@;
}

button.destructive-action:hover {
  background-color: @gtk_error_hover@;
  border-color: @gtk_error_hover@;
}

button.destructive-action:active,
button.destructive-action:checked {
  background-color: @gtk_error_active@;
  border-color: @gtk_error_active@;
}

button.destructive-action:disabled {
  background-color: @surface0@;
  color: @overlay1@;
  border-color: @surface1@;
}

button.link,
button:link {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
  color: @link@;
}

button.link:hover,
button:link:hover {
  color: @link_hover@;
  text-decoration: underline;
}

/* ---------------------------------------------------------------------------
   Entries and spin buttons
   ------------------------------------------------------------------------- */

entry,
spinbutton:not(.vertical) {
  background-image: none;
  background-color: @surface0@;
  color: @text@;
  border: 1px solid @surface1@;
  border-radius: 6px;
  box-shadow: none;
  min-height: 22px;
  padding: 4px 8px;
  caret-color: @accent@;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

entry:hover,
spinbutton:not(.vertical):hover {
  border-color: @surface2@;
}

entry:focus,
spinbutton:not(.vertical):focus {
  border-color: @accent@;
  box-shadow: 0 0 0 2px @accent_a25@;
}

entry:disabled,
spinbutton:not(.vertical):disabled {
  background-color: @mantle@;
  color: @overlay1@;
  border-color: @surface0@;
}

entry:backdrop,
spinbutton:not(.vertical):backdrop {
  background-color: @mantle@;
  color: @subtext0@;
  border-color: @surface0@;
}

entry selection {
  background-color: @accent@;
  color: @on_accent@;
}

entry image {
  color: @subtext0@;
}

entry image:hover,
entry image:active {
  color: @text@;
}

entry progress {
  background-color: @accent_a25@;
  border-radius: 6px;
}

spinbutton button {
  background-color: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

spinbutton button:hover {
  background-color: @surface1@;
}

/* ---------------------------------------------------------------------------
   Menus and popovers
   ------------------------------------------------------------------------- */

menu,
.menu,
.context-menu {
  background-color: @mantle@;
  color: @text@;
  border: 1px solid @surface0@;
  border-radius: 8px;
  box-shadow: 0 4px 16px @shadow@;
  padding: 4px;
}

menuitem,
modelbutton {
  min-height: 22px;
  padding: 4px 8px;
  border-radius: 4px;
}

menuitem:hover,
modelbutton:hover {
  background-color: @surface0@;
  color: @text@;
}

menuitem:active,
modelbutton:active {
  background-color: @surface1@;
}

menuitem:disabled,
modelbutton:disabled {
  color: @overlay1@;
}

menu separator {
  background-color: @surface0@;
  margin: 4px 6px;
}

menubar {
  background-color: @crust@;
  color: @text@;
}

menubar > menuitem {
  padding: 4px 8px;
}

menubar > menuitem:hover {
  background-color: @surface0@;
}

popover.background {
  background-color: @mantle@;
  color: @text@;
  border: 1px solid @surface0@;
  border-radius: 8px;
  box-shadow: 0 4px 16px @shadow@;
}

popover.background > contents {
  background-color: @mantle@;
  border-radius: 8px;
}

popover.background > arrow {
  background-color: @mantle@;
  border: 1px solid @surface0@;
}

popover.background list,
popover.background .view {
  background-color: transparent;
}

/* ---------------------------------------------------------------------------
   Toolbars, status bars and action bars
   ------------------------------------------------------------------------- */

toolbar {
  background-color: @mantle@;
  color: @text@;
  border-color: @surface0@;
  padding: 4px;
}

toolbar:backdrop {
  background-color: @base@;
  color: @subtext0@;
}

toolbar button {
  background-color: transparent;
  border-color: transparent;
}

toolbar button:hover {
  background-color: @surface0@;
}

statusbar {
  background-color: @mantle@;
  color: @subtext0@;
  border-color: @surface0@;
}

actionbar > revealer > box {
  background-color: @mantle@;
  border-color: @surface0@;
}

/* ---------------------------------------------------------------------------
   Notebooks and tabs
   ------------------------------------------------------------------------- */

notebook > header {
  background-color: @mantle@;
  border-color: @surface0@;
}

notebook > header > tabs > tab {
  background-color: transparent;
  color: @subtext0@;
  border: none;
  padding: 6px 12px;
}

notebook > header > tabs > tab:hover {
  background-color: @surface0@;
  color: @text@;
}

notebook > header > tabs > tab:checked {
  background-color: @base@;
  color: @text@;
  border-bottom: 2px solid @accent@;
}

notebook > stack {
  background-color: @base@;
}

/* ---------------------------------------------------------------------------
   Lists, trees and sidebars
   ------------------------------------------------------------------------- */

list,
treeview.view,
.view {
  background-color: @base@;
  color: @text@;
  border-color: @surface0@;
}

list row,
treeview.view {
  border-color: @surface0@;
}

list row:hover,
treeview.view:hover {
  background-color: @surface0@;
}

list row:selected,
list row:selected:hover,
treeview.view:selected,
treeview.view:selected:hover {
  background-color: @accent@;
  color: @on_accent@;
}

treeview.view:selected:backdrop {
  background-color: @accent@;
  color: @on_accent@;
}

treeview.view header button {
  background-color: @mantle@;
  color: @subtext0@;
  border-color: @surface0@;
  border-radius: 0;
  min-height: 20px;
}

treeview.view header button:hover {
  background-color: @surface0@;
  color: @text@;
}

.sidebar,
placessidebar,
stacksidebar list {
  background-color: @mantle@;
  color: @text@;
  border-color: @surface0@;
}

.sidebar row,
placessidebar row {
  padding: 6px 8px;
  border-radius: 6px;
}

.sidebar row:hover,
placessidebar row:hover {
  background-color: @surface0@;
}

.sidebar row:selected,
placessidebar row:selected {
  background-color: @accent@;
  color: @on_accent@;
}

.sidebar row:selected image,
placessidebar row:selected image {
  color: @on_accent@;
}

/* ---------------------------------------------------------------------------
   Scrolled windows and scrollbars
   ------------------------------------------------------------------------- */

scrolledwindow {
  border-color: @surface0@;
}

scrollbar {
  background-color: @mantle@;
  border-color: @surface0@;
}

scrollbar trough {
  background-color: @mantle@;
  border-radius: 6px;
}

scrollbar slider {
  background-color: @surface2@;
  border-radius: 6px;
  min-width: 6px;
  min-height: 6px;
}

scrollbar slider:hover {
  background-color: @overlay1@;
}

scrollbar slider:active {
  background-color: @accent@;
}

scrollbar button {
  background-color: transparent;
  border: none;
}

/* ---------------------------------------------------------------------------
   Check boxes, radio buttons and switches
   ------------------------------------------------------------------------- */

check,
radio {
  background-color: @surface0@;
  border: 2px solid @overlay1@;
  color: @on_accent@;
  min-width: 14px;
  min-height: 14px;
  padding: 0;
  transition: background-color 120ms ease, border-color 120ms ease;
}

check {
  border-radius: 4px;
}

radio {
  border-radius: 999px;
}

check:hover,
radio:hover {
  border-color: @accent@;
}

check:checked,
check:indeterminate,
radio:checked,
radio:indeterminate {
  background-color: @accent@;
  border-color: @accent@;
}

check:checked {
  -gtk-icon-source: url("assets/check.svg");
}

check:indeterminate {
  -gtk-icon-source: url("assets/check-mixed.svg");
}

radio:checked {
  -gtk-icon-source: url("assets/radio.svg");
}

check:disabled,
radio:disabled {
  background-color: @mantle@;
  border-color: @surface1@;
  color: @overlay1@;
}

check:checked:disabled {
  -gtk-icon-source: url("assets/check-disabled.svg");
}

check:indeterminate:disabled {
  -gtk-icon-source: url("assets/check-mixed-disabled.svg");
}

radio:checked:disabled {
  -gtk-icon-source: url("assets/radio-disabled.svg");
}

checkbutton label,
radiobutton label {
  padding-left: 4px;
}

switch {
  background-color: @surface1@;
  border: 1px solid @surface2@;
  border-radius: 999px;
  min-width: 40px;
  min-height: 22px;
}

switch:checked {
  background-color: @accent@;
  border-color: @accent@;
}

switch:disabled {
  background-color: @mantle@;
  border-color: @surface0@;
}

switch slider {
  background-color: @text@;
  border-radius: 999px;
  box-shadow: none;
  min-width: 18px;
  min-height: 18px;
  margin: 1px;
}

switch:checked slider {
  background-color: @on_accent@;
}

switch:disabled slider {
  background-color: @overlay1@;
}

/* ---------------------------------------------------------------------------
   Scales and progress bars
   ------------------------------------------------------------------------- */

scale {
  min-height: 16px;
  min-width: 16px;
}

scale trough {
  background-color: @surface1@;
  border: none;
  border-radius: 999px;
  min-height: 6px;
  min-width: 6px;
}

scale highlight {
  background-color: @accent@;
  border-radius: 999px;
}

scale slider {
  background-color: @text@;
  border: 2px solid @accent@;
  border-radius: 999px;
  box-shadow: none;
  min-width: 12px;
  min-height: 12px;
  margin: -5px;
}

scale slider:hover {
  background-color: @accent@;
}

scale slider:active {
  background-color: @gtk_accent_active@;
}

scale value {
  color: @subtext0@;
}

progressbar {
  color: @subtext0@;
}

progressbar trough {
  background-color: @surface1@;
  border-radius: 999px;
  min-height: 6px;
}

progressbar progress {
  background-color: @accent@;
  border-radius: 999px;
}

progressbar text {
  color: @on_accent@;
}

levelbar block {
  border-radius: 3px;
  min-height: 6px;
}

levelbar block.filled {
  background-color: @accent@;
}

levelbar block.low {
  background-color: @yellow@;
}

levelbar block.high,
levelbar block.full {
  background-color: @green@;
}

levelbar block.empty {
  background-color: @surface1@;
}

/* ---------------------------------------------------------------------------
   Tooltips, infobars and dialogs
   ------------------------------------------------------------------------- */

tooltip,
tooltip.background {
  background-color: @mantle@;
  color: @text@;
  border: 1px solid @surface0@;
  border-radius: 6px;
  box-shadow: 0 2px 8px @shadow_soft@;
}

tooltip.background label {
  padding: 4px 6px;
}

infobar {
  border: none;
}

infobar.info,
infobar.question {
  background-color: @teal_a20@;
  color: @text_info@;
  border-bottom: 1px solid @teal@;
}

infobar.warning {
  background-color: @yellow_a20@;
  color: @text_warning@;
  border-bottom: 1px solid @yellow@;
}

infobar.error {
  background-color: @red_a20@;
  color: @text_error@;
  border-bottom: 1px solid @red@;
}

infobar button {
  background-color: transparent;
  border-color: transparent;
  color: inherit;
}

dialog .dialog-action-area button {
  min-width: 80px;
}

messagedialog .titlebar {
  background-color: @crust@;
}

.osd {
  background-color: @mantle@;
  color: @text@;
  border: 1px solid @surface0@;
  border-radius: 8px;
  box-shadow: 0 4px 16px @shadow@;
}

/* ---------------------------------------------------------------------------
   Frames, separators, calendars and file chooser
   ------------------------------------------------------------------------- */

frame > border,
.frame {
  border: 1px solid @surface0@;
  border-radius: 6px;
}

separator {
  background-color: @surface0@;
  min-width: 1px;
  min-height: 1px;
}

paned > separator {
  background-color: @surface0@;
}

calendar {
  background-color: @base@;
  color: @text@;
  border: 1px solid @surface0@;
  border-radius: 6px;
}

calendar:selected {
  background-color: @accent@;
  color: @on_accent@;
}

calendar.header {
  background-color: @mantle@;
}

calendar.button {
  color: @subtext0@;
}

calendar.highlight {
  color: @accent@;
}

calendar:indeterminate {
  color: @overlay1@;
}

filechooser .dialog-action-box {
  border-color: @surface0@;
}

filechooser placessidebar {
  background-color: @mantle@;
}

filechooser .path-bar button {
  padding: 4px 8px;
}

/* ---------------------------------------------------------------------------
   Selection, links and semantic labels
   ------------------------------------------------------------------------- */

selection {
  background-color: @accent@;
  color: @on_accent@;
}

*:link,
button:link {
  color: @link@;
}

*:link:hover,
button:link:hover {
  color: @link_hover@;
}

*:visited,
button:visited {
  color: @mauve@;
}

.success {
  color: @text_success@;
}

.warning {
  color: @text_warning@;
}

.error {
  color: @text_error@;
}

.info,
.question {
  color: @text_info@;
}
