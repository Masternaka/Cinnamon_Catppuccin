# ============================================================================
# Catppuccin Mocha for GTK 2
# Palette: https://catppuccin.com/palette/
# Generated from src/gtk2.gtkrc.in by scripts/build.py
# Do not edit this file directly: edit the template and rebuild.
#
# GTK 2 is legacy, but Nemo, Synaptic and a few Mint tools can still load it.
# Only colors and basic padding are set so the theme stays compatible with the
# stock GTK 2 engine.
# ============================================================================

gtk-color-scheme = "fg_color:#cdd6f4\nbg_color:#1e1e2e\nbase_color:#1e1e2e\ntext_color:#cdd6f4\nselected_bg_color:#cba6f7\nselected_fg_color:#1e1e2e\ntooltip_bg_color:#181825\ntooltip_fg_color:#cdd6f4\nlink_color:#89b4fa"

style "catppuccin-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]        = "#cdd6f4"
  fg[PRELIGHT]      = "#cdd6f4"
  fg[ACTIVE]        = "#cdd6f4"
  fg[SELECTED]      = "#1e1e2e"
  fg[INSENSITIVE]   = "#7f849c"

  bg[NORMAL]        = "#1e1e2e"
  bg[PRELIGHT]      = "#313244"
  bg[ACTIVE]        = "#45475a"
  bg[SELECTED]      = "#cba6f7"
  bg[INSENSITIVE]   = "#181825"

  base[NORMAL]      = "#1e1e2e"
  base[PRELIGHT]    = "#313244"
  base[ACTIVE]      = "#45475a"
  base[SELECTED]    = "#cba6f7"
  base[INSENSITIVE] = "#181825"

  text[NORMAL]      = "#cdd6f4"
  text[PRELIGHT]    = "#cdd6f4"
  text[ACTIVE]      = "#cdd6f4"
  text[SELECTED]    = "#1e1e2e"
  text[INSENSITIVE] = "#7f849c"
}

class "GtkWidget" style "catppuccin-default"

style "catppuccin-button" {
  xthickness = 6
  ythickness = 4

  fg[NORMAL]        = "#cdd6f4"
  fg[PRELIGHT]      = "#cdd6f4"
  fg[ACTIVE]        = "#cdd6f4"
  fg[INSENSITIVE]   = "#7f849c"

  bg[NORMAL]        = "#313244"
  bg[PRELIGHT]      = "#45475a"
  bg[ACTIVE]        = "#585b70"
  bg[INSENSITIVE]   = "#181825"

  text[NORMAL]      = "#cdd6f4"
  text[PRELIGHT]    = "#cdd6f4"
  text[ACTIVE]      = "#cdd6f4"
  text[INSENSITIVE] = "#7f849c"
}

widget_class "*GtkButton*" style "catppuccin-button"

style "catppuccin-entry" {
  xthickness = 4
  ythickness = 4

  fg[NORMAL]        = "#cdd6f4"
  fg[PRELIGHT]      = "#cdd6f4"
  fg[ACTIVE]        = "#cdd6f4"
  fg[SELECTED]      = "#1e1e2e"
  fg[INSENSITIVE]   = "#7f849c"

  bg[NORMAL]        = "#313244"
  bg[PRELIGHT]      = "#313244"
  bg[ACTIVE]        = "#313244"
  bg[SELECTED]      = "#cba6f7"
  bg[INSENSITIVE]   = "#181825"

  base[NORMAL]      = "#313244"
  base[PRELIGHT]    = "#313244"
  base[ACTIVE]      = "#313244"
  base[SELECTED]    = "#cba6f7"
  base[INSENSITIVE] = "#181825"

  text[NORMAL]      = "#cdd6f4"
  text[PRELIGHT]    = "#cdd6f4"
  text[ACTIVE]      = "#cdd6f4"
  text[SELECTED]    = "#1e1e2e"
  text[INSENSITIVE] = "#7f849c"
}

widget_class "*GtkEntry*" style "catppuccin-entry"

style "catppuccin-menu" {
  xthickness = 4
  ythickness = 3

  fg[NORMAL]        = "#cdd6f4"
  fg[PRELIGHT]      = "#cdd6f4"
  fg[ACTIVE]        = "#cdd6f4"
  fg[SELECTED]      = "#1e1e2e"
  fg[INSENSITIVE]   = "#7f849c"

  bg[NORMAL]        = "#181825"
  bg[PRELIGHT]      = "#313244"
  bg[ACTIVE]        = "#45475a"
  bg[SELECTED]      = "#cba6f7"
  bg[INSENSITIVE]   = "#181825"
}

widget_class "*Menu*" style "catppuccin-menu"

style "catppuccin-tooltip" {
  fg[NORMAL]        = "#cdd6f4"
  fg[PRELIGHT]      = "#cdd6f4"

  bg[NORMAL]        = "#181825"
  bg[PRELIGHT]      = "#181825"
}

widget "gtk-tooltip*" style "catppuccin-tooltip"
