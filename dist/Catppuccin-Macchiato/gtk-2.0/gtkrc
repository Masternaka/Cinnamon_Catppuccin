# ============================================================================
# Catppuccin Macchiato for GTK 2
# Palette: https://catppuccin.com/palette/
# Generated from src/gtk2.gtkrc.in by scripts/build.py
# Do not edit this file directly: edit the template and rebuild.
#
# GTK 2 is legacy, but Nemo, Synaptic and a few Mint tools can still load it.
# Only colors and basic padding are set so the theme stays compatible with the
# stock GTK 2 engine.
# ============================================================================

gtk-color-scheme = "fg_color:#cad3f5\nbg_color:#24273a\nbase_color:#24273a\ntext_color:#cad3f5\nselected_bg_color:#c6a0f6\nselected_fg_color:#24273a\ntooltip_bg_color:#1e2030\ntooltip_fg_color:#cad3f5\nlink_color:#8aadf4"

style "catppuccin-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]        = "#cad3f5"
  fg[PRELIGHT]      = "#cad3f5"
  fg[ACTIVE]        = "#cad3f5"
  fg[SELECTED]      = "#24273a"
  fg[INSENSITIVE]   = "#8087a2"

  bg[NORMAL]        = "#24273a"
  bg[PRELIGHT]      = "#363a4f"
  bg[ACTIVE]        = "#494d64"
  bg[SELECTED]      = "#c6a0f6"
  bg[INSENSITIVE]   = "#1e2030"

  base[NORMAL]      = "#24273a"
  base[PRELIGHT]    = "#363a4f"
  base[ACTIVE]      = "#494d64"
  base[SELECTED]    = "#c6a0f6"
  base[INSENSITIVE] = "#1e2030"

  text[NORMAL]      = "#cad3f5"
  text[PRELIGHT]    = "#cad3f5"
  text[ACTIVE]      = "#cad3f5"
  text[SELECTED]    = "#24273a"
  text[INSENSITIVE] = "#8087a2"
}

class "GtkWidget" style "catppuccin-default"

style "catppuccin-button" {
  xthickness = 6
  ythickness = 4

  fg[NORMAL]        = "#cad3f5"
  fg[PRELIGHT]      = "#cad3f5"
  fg[ACTIVE]        = "#cad3f5"
  fg[INSENSITIVE]   = "#8087a2"

  bg[NORMAL]        = "#363a4f"
  bg[PRELIGHT]      = "#494d64"
  bg[ACTIVE]        = "#5b6078"
  bg[INSENSITIVE]   = "#1e2030"

  text[NORMAL]      = "#cad3f5"
  text[PRELIGHT]    = "#cad3f5"
  text[ACTIVE]      = "#cad3f5"
  text[INSENSITIVE] = "#8087a2"
}

widget_class "*GtkButton*" style "catppuccin-button"

style "catppuccin-entry" {
  xthickness = 4
  ythickness = 4

  fg[NORMAL]        = "#cad3f5"
  fg[PRELIGHT]      = "#cad3f5"
  fg[ACTIVE]        = "#cad3f5"
  fg[SELECTED]      = "#24273a"
  fg[INSENSITIVE]   = "#8087a2"

  bg[NORMAL]        = "#363a4f"
  bg[PRELIGHT]      = "#363a4f"
  bg[ACTIVE]        = "#363a4f"
  bg[SELECTED]      = "#c6a0f6"
  bg[INSENSITIVE]   = "#1e2030"

  base[NORMAL]      = "#363a4f"
  base[PRELIGHT]    = "#363a4f"
  base[ACTIVE]      = "#363a4f"
  base[SELECTED]    = "#c6a0f6"
  base[INSENSITIVE] = "#1e2030"

  text[NORMAL]      = "#cad3f5"
  text[PRELIGHT]    = "#cad3f5"
  text[ACTIVE]      = "#cad3f5"
  text[SELECTED]    = "#24273a"
  text[INSENSITIVE] = "#8087a2"
}

widget_class "*GtkEntry*" style "catppuccin-entry"

style "catppuccin-menu" {
  xthickness = 4
  ythickness = 3

  fg[NORMAL]        = "#cad3f5"
  fg[PRELIGHT]      = "#cad3f5"
  fg[ACTIVE]        = "#cad3f5"
  fg[SELECTED]      = "#24273a"
  fg[INSENSITIVE]   = "#8087a2"

  bg[NORMAL]        = "#1e2030"
  bg[PRELIGHT]      = "#363a4f"
  bg[ACTIVE]        = "#494d64"
  bg[SELECTED]      = "#c6a0f6"
  bg[INSENSITIVE]   = "#1e2030"
}

widget_class "*Menu*" style "catppuccin-menu"

style "catppuccin-tooltip" {
  fg[NORMAL]        = "#cad3f5"
  fg[PRELIGHT]      = "#cad3f5"

  bg[NORMAL]        = "#1e2030"
  bg[PRELIGHT]      = "#1e2030"
}

widget "gtk-tooltip*" style "catppuccin-tooltip"
