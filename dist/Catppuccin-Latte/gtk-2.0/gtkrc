# ============================================================================
# Catppuccin Latte for GTK 2
# Palette: https://catppuccin.com/palette/
# Generated from src/gtk2.gtkrc.in by scripts/build.py
# Do not edit this file directly: edit the template and rebuild.
#
# GTK 2 is legacy, but Nemo, Synaptic and a few Mint tools can still load it.
# Only colors and basic padding are set so the theme stays compatible with the
# stock GTK 2 engine.
# ============================================================================

gtk-color-scheme = "fg_color:#4c4f69\nbg_color:#eff1f5\nbase_color:#eff1f5\ntext_color:#4c4f69\nselected_bg_color:#1e66f5\nselected_fg_color:#f4f5f8\ntooltip_bg_color:#e6e9ef\ntooltip_fg_color:#4c4f69\nlink_color:#0a55ea"

style "catppuccin-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]        = "#4c4f69"
  fg[PRELIGHT]      = "#4c4f69"
  fg[ACTIVE]        = "#4c4f69"
  fg[SELECTED]      = "#f4f5f8"
  fg[INSENSITIVE]   = "#8c8fa1"

  bg[NORMAL]        = "#eff1f5"
  bg[PRELIGHT]      = "#ccd0da"
  bg[ACTIVE]        = "#bcc0cc"
  bg[SELECTED]      = "#1e66f5"
  bg[INSENSITIVE]   = "#e6e9ef"

  base[NORMAL]      = "#eff1f5"
  base[PRELIGHT]    = "#ccd0da"
  base[ACTIVE]      = "#bcc0cc"
  base[SELECTED]    = "#1e66f5"
  base[INSENSITIVE] = "#e6e9ef"

  text[NORMAL]      = "#4c4f69"
  text[PRELIGHT]    = "#4c4f69"
  text[ACTIVE]      = "#4c4f69"
  text[SELECTED]    = "#f4f5f8"
  text[INSENSITIVE] = "#8c8fa1"
}

class "GtkWidget" style "catppuccin-default"

style "catppuccin-button" {
  xthickness = 6
  ythickness = 4

  fg[NORMAL]        = "#4c4f69"
  fg[PRELIGHT]      = "#4c4f69"
  fg[ACTIVE]        = "#4c4f69"
  fg[INSENSITIVE]   = "#8c8fa1"

  bg[NORMAL]        = "#ccd0da"
  bg[PRELIGHT]      = "#bcc0cc"
  bg[ACTIVE]        = "#acb0be"
  bg[INSENSITIVE]   = "#e6e9ef"

  text[NORMAL]      = "#4c4f69"
  text[PRELIGHT]    = "#4c4f69"
  text[ACTIVE]      = "#4c4f69"
  text[INSENSITIVE] = "#8c8fa1"
}

widget_class "*GtkButton*" style "catppuccin-button"

style "catppuccin-entry" {
  xthickness = 4
  ythickness = 4

  fg[NORMAL]        = "#4c4f69"
  fg[PRELIGHT]      = "#4c4f69"
  fg[ACTIVE]        = "#4c4f69"
  fg[SELECTED]      = "#f4f5f8"
  fg[INSENSITIVE]   = "#8c8fa1"

  bg[NORMAL]        = "#ccd0da"
  bg[PRELIGHT]      = "#ccd0da"
  bg[ACTIVE]        = "#ccd0da"
  bg[SELECTED]      = "#1e66f5"
  bg[INSENSITIVE]   = "#e6e9ef"

  base[NORMAL]      = "#ccd0da"
  base[PRELIGHT]    = "#ccd0da"
  base[ACTIVE]      = "#ccd0da"
  base[SELECTED]    = "#1e66f5"
  base[INSENSITIVE] = "#e6e9ef"

  text[NORMAL]      = "#4c4f69"
  text[PRELIGHT]    = "#4c4f69"
  text[ACTIVE]      = "#4c4f69"
  text[SELECTED]    = "#f4f5f8"
  text[INSENSITIVE] = "#8c8fa1"
}

widget_class "*GtkEntry*" style "catppuccin-entry"

style "catppuccin-menu" {
  xthickness = 4
  ythickness = 3

  fg[NORMAL]        = "#4c4f69"
  fg[PRELIGHT]      = "#4c4f69"
  fg[ACTIVE]        = "#4c4f69"
  fg[SELECTED]      = "#f4f5f8"
  fg[INSENSITIVE]   = "#8c8fa1"

  bg[NORMAL]        = "#e6e9ef"
  bg[PRELIGHT]      = "#ccd0da"
  bg[ACTIVE]        = "#bcc0cc"
  bg[SELECTED]      = "#1e66f5"
  bg[INSENSITIVE]   = "#e6e9ef"
}

widget_class "*Menu*" style "catppuccin-menu"

style "catppuccin-tooltip" {
  fg[NORMAL]        = "#4c4f69"
  fg[PRELIGHT]      = "#4c4f69"

  bg[NORMAL]        = "#e6e9ef"
  bg[PRELIGHT]      = "#e6e9ef"
}

widget "gtk-tooltip*" style "catppuccin-tooltip"
