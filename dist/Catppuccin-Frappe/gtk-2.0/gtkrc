# ============================================================================
# Catppuccin Frappé for GTK 2
# Palette: https://catppuccin.com/palette/
# Generated from src/gtk2.gtkrc.in by scripts/build.py
# Do not edit this file directly: edit the template and rebuild.
#
# GTK 2 is legacy, but Nemo, Synaptic and a few Mint tools can still load it.
# Only colors and basic padding are set so the theme stays compatible with the
# stock GTK 2 engine.
# ============================================================================

gtk-color-scheme = "fg_color:#c6d0f5\nbg_color:#303446\nbase_color:#303446\ntext_color:#c6d0f5\nselected_bg_color:#8caaee\nselected_fg_color:#303446\ntooltip_bg_color:#292c3c\ntooltip_fg_color:#c6d0f5\nlink_color:#8caaee"

style "catppuccin-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]        = "#c6d0f5"
  fg[PRELIGHT]      = "#c6d0f5"
  fg[ACTIVE]        = "#c6d0f5"
  fg[SELECTED]      = "#303446"
  fg[INSENSITIVE]   = "#838ba7"

  bg[NORMAL]        = "#303446"
  bg[PRELIGHT]      = "#414559"
  bg[ACTIVE]        = "#51576d"
  bg[SELECTED]      = "#8caaee"
  bg[INSENSITIVE]   = "#292c3c"

  base[NORMAL]      = "#303446"
  base[PRELIGHT]    = "#414559"
  base[ACTIVE]      = "#51576d"
  base[SELECTED]    = "#8caaee"
  base[INSENSITIVE] = "#292c3c"

  text[NORMAL]      = "#c6d0f5"
  text[PRELIGHT]    = "#c6d0f5"
  text[ACTIVE]      = "#c6d0f5"
  text[SELECTED]    = "#303446"
  text[INSENSITIVE] = "#838ba7"
}

class "GtkWidget" style "catppuccin-default"

style "catppuccin-button" {
  xthickness = 6
  ythickness = 4

  fg[NORMAL]        = "#c6d0f5"
  fg[PRELIGHT]      = "#c6d0f5"
  fg[ACTIVE]        = "#c6d0f5"
  fg[INSENSITIVE]   = "#838ba7"

  bg[NORMAL]        = "#414559"
  bg[PRELIGHT]      = "#51576d"
  bg[ACTIVE]        = "#626880"
  bg[INSENSITIVE]   = "#292c3c"

  text[NORMAL]      = "#c6d0f5"
  text[PRELIGHT]    = "#c6d0f5"
  text[ACTIVE]      = "#c6d0f5"
  text[INSENSITIVE] = "#838ba7"
}

widget_class "*GtkButton*" style "catppuccin-button"

style "catppuccin-entry" {
  xthickness = 4
  ythickness = 4

  fg[NORMAL]        = "#c6d0f5"
  fg[PRELIGHT]      = "#c6d0f5"
  fg[ACTIVE]        = "#c6d0f5"
  fg[SELECTED]      = "#303446"
  fg[INSENSITIVE]   = "#838ba7"

  bg[NORMAL]        = "#414559"
  bg[PRELIGHT]      = "#414559"
  bg[ACTIVE]        = "#414559"
  bg[SELECTED]      = "#8caaee"
  bg[INSENSITIVE]   = "#292c3c"

  base[NORMAL]      = "#414559"
  base[PRELIGHT]    = "#414559"
  base[ACTIVE]      = "#414559"
  base[SELECTED]    = "#8caaee"
  base[INSENSITIVE] = "#292c3c"

  text[NORMAL]      = "#c6d0f5"
  text[PRELIGHT]    = "#c6d0f5"
  text[ACTIVE]      = "#c6d0f5"
  text[SELECTED]    = "#303446"
  text[INSENSITIVE] = "#838ba7"
}

widget_class "*GtkEntry*" style "catppuccin-entry"

style "catppuccin-menu" {
  xthickness = 4
  ythickness = 3

  fg[NORMAL]        = "#c6d0f5"
  fg[PRELIGHT]      = "#c6d0f5"
  fg[ACTIVE]        = "#c6d0f5"
  fg[SELECTED]      = "#303446"
  fg[INSENSITIVE]   = "#838ba7"

  bg[NORMAL]        = "#292c3c"
  bg[PRELIGHT]      = "#414559"
  bg[ACTIVE]        = "#51576d"
  bg[SELECTED]      = "#8caaee"
  bg[INSENSITIVE]   = "#292c3c"
}

widget_class "*Menu*" style "catppuccin-menu"

style "catppuccin-tooltip" {
  fg[NORMAL]        = "#c6d0f5"
  fg[PRELIGHT]      = "#c6d0f5"

  bg[NORMAL]        = "#292c3c"
  bg[PRELIGHT]      = "#292c3c"
}

widget "gtk-tooltip*" style "catppuccin-tooltip"
